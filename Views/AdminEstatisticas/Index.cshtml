@using System.Globalization
@{
    ViewData["Title"] = "Estatísticas";
    var periodo = (ViewBag.Periodo as string) ?? "30d";
    var start = (DateTime?)ViewBag.Start;
    var end = (DateTime?)ViewBag.End;
    var today = (string)ViewBag.Today ?? "";
    var erroPeriodo = ViewBag.ErroPeriodo as string;

    var customStart = ViewBag.CustomStart as string;
    var customEnd = ViewBag.CustomEnd as string;

    var anunciosPorEstado = ViewBag.AnunciosPorEstado as IDictionary<string, int> ?? new Dictionary<string, int>();
    var encomendasPorEstado = ViewBag.EncomendasPorEstado as IDictionary<string, int> ?? new Dictionary<string, int>();
    var reservasPorEstado = ViewBag.ReservasPorEstado as IDictionary<string, int> ?? new Dictionary<string, int>();

    var vendasSerie = ViewBag.VendasSerie as List<KeyValuePair<string, int>> ?? new();
    var topMarcas = ViewBag.TopMarcas as List<KeyValuePair<string, int>> ?? new();
    var topModelos = ViewBag.TopModelos as List<KeyValuePair<string, int>> ?? new();
    var topVendedores = ViewBag.TopVendedores as List<KeyValuePair<string, int>> ?? new();
    var topMarcasFavoritas = ViewBag.TopMarcasFavoritas as List<KeyValuePair<string, int>> ?? new();


    var culturaPt = CultureInfo.GetCultureInfo("pt-PT");

    double? mediaVisitasAtivos = (double?)ViewBag.MediaVisitasPorAnuncioAtivos;

    var topLocalizacoesAnuncios = ViewBag.TopLocalizacoesAnuncios as List<KeyValuePair<string, int>> ?? new();
    var topLocalizacoesVendas = ViewBag.TopLocalizacoesVendas as List<KeyValuePair<string, int>> ?? new();

    var stockAnoMin = (short?)ViewBag.StockAnoMin;
    var stockAnoMax = (short?)ViewBag.StockAnoMax;
    var stockAnoMedio = (double?)ViewBag.StockAnoMedio;

    var stockTopAnos = ViewBag.StockTopAnos as List<KeyValuePair<string, int>> ?? new();
    var stockKmDistribuicao = ViewBag.StockKmDistribuicao as List<KeyValuePair<string, int>> ?? new();
    var stockTopCores = ViewBag.StockTopCores as List<KeyValuePair<string, int>> ?? new();

    var novosUtilizadores = (int)(ViewBag.NovosUtilizadores ?? 0);
    var novosCompradores = (int)(ViewBag.NovosCompradores ?? 0);
    var novosVendedores = (int)(ViewBag.NovosVendedores ?? 0);
    var novosAdmins = (int)(ViewBag.NovosAdmins ?? 0);

    var bloqueadosCompradores = (int)(ViewBag.BloqueadosCompradores ?? 0);
    var bloqueadosVendedores = (int)(ViewBag.BloqueadosVendedores ?? 0);
    var bloqueadosAdmins = (int)(ViewBag.BloqueadosAdmins ?? 0);


    int Get(IDictionary<string, int> d, string k) => d.TryGetValue(k, out var v) ? v : 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Estatísticas</h2>

    <form method="get" class="d-flex gap-2 align-items-end flex-wrap">
        <div>
            <label class="form-label mb-1">Período</label>
            <select name="periodo" class="form-select">
                <option value="1d" selected="@(periodo == "1d")">Último 1 dia</option>
                <option value="7d" selected="@(periodo == "7d")">Últimos 7 dias</option>
                <option value="30d" selected="@(periodo == "30d")">Últimos 30 dias</option>
                <option value="3m" selected="@(periodo == "3m")">Últimos 3 meses</option>
                <option value="6m" selected="@(periodo == "6m")">Últimos 6 meses</option>
                <option value="12m" selected="@(periodo == "12m")">Últimos 12 meses</option>
                <option value="all" selected="@(periodo == "all")">Desde sempre</option>
                <option value="custom" selected="@(periodo == "custom")">Intervalo personalizado</option>
            </select>
        </div>

        <div>
            <label class="form-label mb-1">Data início</label>
            <input type="date" name="dataInicio" class="form-control"
                   value="@(customStart ?? "")"
                   max="@today" />
        </div>

        <div>
            <label class="form-label mb-1">Data fim</label>
            <input type="date" name="dataFim" class="form-control"
                   value="@(customEnd ?? "")"
                   max="@today" />
        </div>

        <button class="btn btn-primary" type="submit">Aplicar</button>
    </form>
</div>

@if (start.HasValue && end.HasValue)
{
    <div class="text-muted mb-3">
        Período considerado:
        <strong>@start.Value.ToString("dd/MM/yyyy")</strong>
        até
        <strong>@end.Value.ToString("dd/MM/yyyy")</strong> (UTC).
    </div>
}
else if (start.HasValue)
{
    <div class="text-muted mb-3">
        Período considerado: desde <strong>@start.Value.ToString("dd/MM/yyyy HH:mm")</strong> (UTC).
    </div>
}

@if (!string.IsNullOrWhiteSpace(erroPeriodo))
{
    <div class="alert alert-warning mt-3 mb-0">
        @erroPeriodo
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Utilizadores</div>
                <div class="fs-4 fw-bold">@ViewBag.TotalUtilizadores</div>
                <div class="small text-muted">Total no sistema</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Bloqueados</div>
                <div class="fs-4 fw-bold">@ViewBag.TotalBloqueados</div>
                <div class="small text-muted">
                    Admins: @bloqueadosAdmins · Vendedores: @bloqueadosVendedores · Compradores: @bloqueadosCompradores
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Admins</div>
                <div class="fs-4 fw-bold">@ViewBag.TotalAdmins</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Compradores</div>
                <div class="fs-4 fw-bold">@ViewBag.TotalCompradores</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Vendedores</div>
                <div class="fs-4 fw-bold">@ViewBag.TotalVendedores</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header fw-semibold">Anúncios (por estado)</div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <tbody>
                        @foreach (var kv in anunciosPorEstado.OrderByDescending(x => x.Value))
                        {
                            <tr>
                                <td>@kv.Key</td>
                                <td class="text-end">@kv.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <hr />

                <div class="small text-muted">
                    Preço médio (ativos): <strong>
                        @(ViewBag.PrecoMedioAtivos == null
                                                ? "—"
                                                : string.Format(culturaPt, "{0:C}", (decimal)ViewBag.PrecoMedioAtivos))
                    </strong>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header fw-semibold">Encomendas (por estado)</div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <tbody>
                        @foreach (var kv in encomendasPorEstado.OrderByDescending(x => x.Value))
                        {
                            <tr>
                                <td>@kv.Key</td>
                                <td class="text-end">@kv.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <hr />
                <div class="small text-muted">
                    Vendas pagas no período: <strong>@ViewBag.TotalVendasPeriodo</strong>
                </div>
                <div class="small text-muted">
                    Receita (aprox.) no período: <strong>@string.Format(culturaPt, "{0:C}", (decimal)ViewBag.ReceitaPeriodo)</strong>
                </div>
                <div class="small text-muted">
                    Tempo médio até venda (dias): <strong>@(ViewBag.TempoMedioVendaDias == null ? "—" : ((double)ViewBag.TempoMedioVendaDias).ToString("0.0", culturaPt))</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header fw-semibold">Reservas (por estado)</div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <tbody>
                        @foreach (var kv in reservasPorEstado.OrderByDescending(x => x.Value))
                        {
                            <tr>
                                <td>@kv.Key</td>
                                <td class="text-end">@kv.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="mt-2 small text-muted">
                    Nota: o anúncio tem prazo de reserva default de 168h (7 dias) no esquema.:contentReference[oaicite:10]{index=10}
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">Vendas pagas por período</div>
            <div class="card-body">
                @if (vendasSerie.Count == 0)
                {
                    <div class="text-muted">Sem dados no período selecionado.</div>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th class="text-end">Vendas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in vendasSerie)
                            {
                                <tr>
                                    <td>@p.Key</td>
                                    <td class="text-end">@p.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-3">
        <div class="card h-100">
            <div class="card-header fw-semibold">Top Marcas (vendas)</div>
            <div class="card-body">
                @if (topMarcas.Count == 0)
                {
                    <div class="text-muted">Sem dados.</div>
                }
                else
                {
                    <ol class="mb-0">
                        @foreach (var x in topMarcas)
                        {
                            <li>@x.Key <span class="text-muted">(@x.Value)</span></li>
                        }
                    </ol>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-3">
        <div class="card h-100">
            <div class="card-header fw-semibold">Top Modelos (vendas)</div>
            <div class="card-body">
                @if (topModelos.Count == 0)
                {
                    <div class="text-muted">Sem dados.</div>
                }
                else
                {
                    <ol class="mb-0">
                        @foreach (var x in topModelos)
                        {
                            <li>@x.Key <span class="text-muted">(@x.Value)</span></li>
                        }
                    </ol>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-3">
        <div class="card h-100">
            <div class="card-header fw-semibold">Top Marcas Favoritadas</div>
            <div class="card-body">
                @if (topMarcasFavoritas.Count == 0)
                {
                    <div class="text-muted">Sem dados.</div>
                }
                else
                {
                    <ol class="mb-0">
                        @foreach (var x in topMarcasFavoritas)
                        {
                            <li>@x.Key <span class="text-muted">(@x.Value)</span></li>
                        }
                    </ol>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">Top Vendedores (vendas pagas no período)</div>
            <div class="card-body">
                @if (topVendedores.Count == 0)
                {
                    <div class="text-muted">Sem dados.</div>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Vendedor</th>
                                <th class="text-end">Vendas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var x in topVendedores)
                            {
                                <tr>
                                    <td>@x.Key</td>
                                    <td class="text-end">@x.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header fw-semibold">Visitas por anúncio (ativos)</div>
            <div class="card-body">
                <div class="text-muted small">Considera visitas "agendada" e "realizada".</div>

                <div class="mt-2">
                    <div class="text-muted">Média</div>
                    <div class="fs-4 fw-bold">
                        @(mediaVisitasAtivos == null ? "—" : mediaVisitasAtivos.Value.ToString("0.00", culturaPt))
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">Top localizações (anúncios ativos)</div>
            <div class="card-body">
                @if (topLocalizacoesAnuncios.Count == 0)
                {
                    <div class="text-muted">Sem dados.</div>
                }
                else
                {
                    <ol class="mb-0">
                        @foreach (var x in topLocalizacoesAnuncios)
                        {
                            <li>@x.Key <span class="text-muted">(@x.Value)</span></li>
                        }
                    </ol>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">Top localizações (vendas pagas no período)</div>
            <div class="card-body">
                @if (topLocalizacoesVendas.Count == 0)
                {
                    <div class="text-muted">Sem dados.</div>
                }
                else
                {
                    <ol class="mb-0">
                        @foreach (var x in topLocalizacoesVendas)
                        {
                            <li>@x.Key <span class="text-muted">(@x.Value)</span></li>
                        }
                    </ol>
                }
            </div>
        </div>
    </div>
</div>



<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header fw-semibold">Stock — Anos</div>
            <div class="card-body">
                <div class="small text-muted mb-2">Baseado em anúncios ativos.</div>

                <div class="d-flex justify-content-between">
                    <div class="text-muted">Min</div>
                    <div class="fw-semibold">@(stockAnoMin?.ToString() ?? "—")</div>
                </div>
                <div class="d-flex justify-content-between">
                    <div class="text-muted">Max</div>
                    <div class="fw-semibold">@(stockAnoMax?.ToString() ?? "—")</div>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <div class="text-muted">Média</div>
                    <div class="fw-semibold">@(stockAnoMedio == null ? "—" : stockAnoMedio.Value.ToString("0.0", culturaPt))</div>
                </div>

                <div class="fw-semibold mb-1">Top anos</div>
                @if (stockTopAnos.Count == 0)
                {
                    <div class="text-muted">Sem dados.</div>
                }
                else
                {
                    <ol class="mb-0">
                        @foreach (var x in stockTopAnos)
                        {
                            <li>@x.Key <span class="text-muted">(@x.Value)</span></li>
                        }
                    </ol>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header fw-semibold">Stock — Quilometragem</div>
            <div class="card-body">
                <div class="small text-muted mb-2">Distribuição por faixas (anúncios ativos).</div>

                @if (stockKmDistribuicao.Count == 0)
                {
                    <div class="text-muted">Sem dados.</div>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Faixa</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var x in stockKmDistribuicao)
                            {
                                <tr>
                                    <td>@x.Key</td>
                                    <td class="text-end">@x.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header fw-semibold">Stock — Cores (Top 10)</div>
            <div class="card-body">
                <div class="small text-muted mb-2">Cores mais comuns (anúncios ativos).</div>

                @if (stockTopCores.Count == 0)
                {
                    <div class="text-muted">Sem dados.</div>
                }
                else
                {
                    <ol class="mb-0">
                        @foreach (var x in stockTopCores)
                        {
                            <li>@x.Key <span class="text-muted">(@x.Value)</span></li>
                        }
                    </ol>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Novos utilizadores</div>
                <div class="fs-4 fw-bold">@novosUtilizadores</div>
                <div class="small text-muted">No período selecionado</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Novos compradores</div>
                <div class="fs-4 fw-bold">@novosCompradores</div>
                <div class="small text-muted">No período selecionado</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Novos vendedores</div>
                <div class="fs-4 fw-bold">@novosVendedores</div>
                <div class="small text-muted">No período selecionado</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Novos admins</div>
                <div class="fs-4 fw-bold">@novosAdmins</div>
                <div class="small text-muted">No período selecionado</div>
            </div>
        </div>
    </div>
</div>
