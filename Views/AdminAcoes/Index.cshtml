@model List<AutoMarket.Models.Market.Ace_Admin_Acao>

@{
    ViewData["Title"] = "Histórico de ações";

    var tipoAtual = (ViewData["TipoAtual"] as string) ?? "todas";
    var adminAtual = (ViewData["AdminAtual"] as string) ?? "";
    var utilizadorAtual = (ViewData["UtilizadorAtual"] as string) ?? "";

    var ordemAtual = (ViewData["OrdemAtual"] as string) ?? "recentes";
    var dataInicioAtual = ViewData["DataInicioAtual"] as DateTime?;
    var dataFimAtual = ViewData["DataFimAtual"] as DateTime?;
}

<div class="admin-page">
    <div class="admin-card">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <h1 class="page-title mb-0">@ViewData["Title"]</h1>
        </div>

        <!-- Filtros -->
        <div class="card card-soft mb-3">
            <div class="card-body">

                <form id="filtroForm"
                      method="get"
                      asp-controller="AdminAcoes"
                      asp-action="Lista"
                      data-ajax="true"
                      data-ajax-method="get"
                      data-ajax-mode="replace"
                      data-ajax-update="#acoesArea"
                      class="row g-3 align-items-end">

                    <div class="col-md-3">
                        <label class="form-label" for="tipo">Tipo de ação</label>
                        <select class="form-select form-control-soft" id="tipo" name="tipo">
                            <option value="todas" selected="@(tipoAtual == "todas")">Todas</option>
                            <option value="aprovar_vendedor" selected="@(tipoAtual == "aprovar_vendedor")">aprovar_vendedor</option>
                            <option value="rejeitar_vendedor" selected="@(tipoAtual == "rejeitar_vendedor")">rejeitar_vendedor</option>
                            <option value="bloquear" selected="@(tipoAtual == "bloquear")">bloquear</option>
                            <option value="desbloquear" selected="@(tipoAtual == "desbloquear")">desbloquear</option>
                            <option value="remover_admin" selected="@(tipoAtual == "remover_admin")">remover_admin</option>
                            <option value="recuperar_admin" selected="@(tipoAtual == "recuperar_admin")">recuperar_admin</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="admin">Admin (ID/username/email)</label>
                        <input class="form-control form-control-soft" id="admin" name="admin" value="@adminAtual" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="utilizador">Utilizador (ID/username/email)</label>
                        <input class="form-control form-control-soft" id="utilizador" name="utilizador" value="@utilizadorAtual" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label" for="ordem">Ordenação</label>
                        <select class="form-select form-control-soft" id="ordem" name="ordem">
                            <option value="recentes" selected="@(ordemAtual == "recentes")">Mais recentes</option>
                            <option value="antigas" selected="@(ordemAtual == "antigas")">Mais antigas</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label" for="dataInicio">Data início</label>
                        <input type="date"
                               class="form-control form-control-soft"
                               id="dataInicio"
                               name="dataInicio"
                               value="@(dataInicioAtual.HasValue? dataInicioAtual.Value.ToString("yyyy-MM-dd") : "")" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label" for="dataFim">Data fim</label>
                        <input type="date"
                               class="form-control form-control-soft"
                               id="dataFim"
                               name="dataFim"
                               value="@(dataFimAtual.HasValue? dataFimAtual.Value.ToString("yyyy-MM-dd") : "")" />
                    </div>

                    <!-- ✅ Botão Aplicar (estilo preto) -->
                    <div class="col-md-3 d-grid">
                        <button type="submit" class="btn btn-dark-custom btn-apply">
                            Aplicar
                        </button>
                    </div>
                </form>

            </div>
        </div>

        <!-- Área AJAX -->
        <div id="acoesArea">
            <partial name="_AcoesTable" model="Model" />
        </div>

    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('filtroForm');
            if (!form) return;

            const admin = document.getElementById('admin');
            const utilizador = document.getElementById('utilizador');

            function debounce(fn, delay) {
                let t = null;
                return function () {
                    clearTimeout(t);
                    t = setTimeout(fn, delay);
                };
            }

            const submitDebounced = debounce(function () {
                $(form).submit();
            }, 400);

            if (admin) admin.addEventListener('input', submitDebounced);
            if (utilizador) utilizador.addEventListener('input', submitDebounced);
        })();
    </script>
}

<style>
    .admin-page {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        background-color: #f5f5f5;
        min-height: calc(100vh - 70px);
        padding: 32px 20px;
    }

    .admin-card {
        background-color: #ffffff;
        border-radius: 14px;
        padding: 40px;
        max-width: 1200px;
        margin: 0 auto;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .page-title {
        font-weight: 800;
        color: #111;
        letter-spacing: -0.3px;
    }

    .card-soft {
        border: 1px solid rgba(0,0,0,0.06);
        border-radius: 14px;
        box-shadow: 0 8px 22px rgba(0,0,0,0.05);
    }

    .form-control-soft {
        border-radius: 12px;
        padding: 10px 12px;
        border: 1px solid rgba(0,0,0,0.10);
        height: 42px;
    }

        .form-control-soft:focus {
            border-color: rgba(0,0,0,0.35);
            box-shadow: 0 0 0 0.2rem rgba(0,0,0,0.08);
        }

    .form-select.form-control-soft {
        padding-right: 2.75rem;
        background-position: right .9rem center;
        background-size: 16px 12px;
    }

    /* ✅ botão preto igual aos outros ecrãs */
    .btn-dark-custom {
        background: #000;
        color: #fff;
        border: none;
        border-radius: 12px;
        font-weight: 650;
    }

        .btn-dark-custom:hover {
            background: #1b1b1b;
            color: #fff;
        }

    .btn-apply {
        height: 42px;
    }

    @@media (max-width: 576px) {
        .admin-card {
            padding: 22px;
        }
    }
</style>
