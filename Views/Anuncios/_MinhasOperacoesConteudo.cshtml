@using AutoMarket.Models.Market
@model List<Reserva>

@{
    var tipo = (ViewBag.Tipo as string) ?? "todos";
    
    // ✅ Garantir que NUNCA é null
    var reservas = Model ?? new List<Reserva>();
    var encomendas = (ViewBag.Encomendas as List<Encomenda>) ?? new List<Encomenda>();
}

<!-- ✅ SECÇÃO: RESERVAS -->
@if (tipo is "todos" or "reservas")
{
    <div class="ops-section mb-4">
        <h5 class="ops-section-title">
            <i class="bi bi-bookmark"></i> Reservas
        </h5>

        <div class="card card-soft">
            <div class="card-body">
                <!-- Filtros AJAX -->
                <form id="filtrosMinhasReservas"
                      method="get"
                      asp-controller="Anuncios"
                      asp-action="ListaMinhasReservas"
                      data-ajax="true"
                      data-ajax-method="GET"
                      data-ajax-mode="replace"
                      data-ajax-update="#reservasListaArea"
                      class="row g-2 align-items-end mb-3">

                    <div class="col-md-4">
                        <label class="form-label small mb-1">Estado</label>
                        <select id="minhasReservasEstado" name="estado" class="form-select form-select-sm">
                            <option value="todos">Todos</option>
                            <option value="ativa">Ativa</option>
                            <option value="expirada">Expirada</option>
                            <option value="cancelada">Cancelada</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small mb-1">Ordenação</label>
                        <select id="minhasReservasOrdem" name="ordem" class="form-select form-select-sm">
                            <option value="recent" selected>Mais recentes</option>
                            <option value="oldest">Mais antigas</option>
                            <option value="expira_proxima">Expira mais próximo</option>
                            <option value="expira_longe">Expira mais distante</option>
                        </select>
                    </div>
                </form>

                <!-- Área AJAX -->
                <div id="reservasListaArea">
                    @* ✅ PATH CORRETO + model garantidamente não-null *@
                    @await Html.PartialAsync("~/Views/Reservas/_MinhasReservasLista.cshtml", reservas)
                </div>
            </div>
        </div>
    </div>
}

<!-- ✅ SECÇÃO: VISITAS -->
@if (tipo is "todos" or "visitas")
{
    <div class="ops-section mb-4">
        <h5 class="ops-section-title">
            <i class="bi bi-calendar2-check"></i> Visitas
        </h5>

        <div class="card card-soft">
            <div class="card-body">
                <!-- Filtros AJAX -->
                <form id="filtrosMinhasVisitas"
                      method="get"
                      asp-controller="Visitas"
                      asp-action="ListaMinhasVisitas"
                      data-ajax="true"
                      data-ajax-method="GET"
                      data-ajax-mode="replace"
                      data-ajax-update="#visitasListaArea"
                      class="row g-2 align-items-end mb-3">

                    <div class="col-md-4">
                        <label class="form-label small mb-1">Estado</label>
                        <select id="minhasVisitasEstado" name="estado" class="form-select form-select-sm">
                            <option value="todos">Todos</option>
                            <option value="pendente">Pendente</option>
                            <option value="agendada">Agendada</option>
                            <option value="realizada">Realizada</option>
                            <option value="cancelada">Cancelada</option>
                            <option value="rejeitada">Rejeitada</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small mb-1">Ordenação</label>
                        <select id="minhasVisitasOrdem" name="ordem" class="form-select form-select-sm">
                            <option value="recent" selected>Mais recentes</option>
                            <option value="oldest">Mais antigas</option>
                            <option value="data_proxima">Data: mais próxima</option>
                            <option value="data_longe">Data: mais distante</option>
                        </select>
                    </div>
                </form>

                <!-- Área AJAX -->
                <div id="visitasListaArea">
                    <!-- Carrega via JS ao entrar no tab -->
                </div>
            </div>
        </div>
    </div>
}

<!-- ✅ SECÇÃO: ENCOMENDAS -->
@if (tipo is "todos" or "encomendas")
{
    <div class="ops-section mb-4">
        <h5 class="ops-section-title">
            <i class="bi bi-cart-check"></i> Encomendas
        </h5>

        <div class="card card-soft">
            <div class="card-body">
                <!-- Filtros AJAX -->
                <form id="filtrosMinhasEncomendas"
                      method="get"
                      asp-controller="Encomendas"
                      asp-action="ListaMinhasEncomendas"
                      data-ajax="true"
                      data-ajax-method="GET"
                      data-ajax-mode="replace"
                      data-ajax-update="#encomendasListaArea"
                      class="row g-2 align-items-end mb-3">

                    <div class="col-md-4">
                        <label class="form-label small mb-1">Estado</label>
                        <select id="minhasEncomendasEstado" name="estado" class="form-select form-select-sm">
                            <option value="todos">Todos</option>
                            <option value="pendente">Pendente</option>
                            <option value="pago">Pago</option>
                            <option value="cancelado">Cancelado</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small mb-1">Ordenação</label>
                        <select id="minhasEncomendasOrdem" name="ordem" class="form-select form-select-sm">
                            <option value="recent" selected>Mais recente</option>
                            <option value="oldest">Mais antigo</option>
                        </select>
                    </div>
                </form>

                <!-- Área AJAX -->
                <div id="encomendasListaArea">
                    @* ✅ Passa lista garantidamente não-null *@
                    @await Html.PartialAsync("~/Views/Encomendas/_MinhasEncomendasLista.cshtml", encomendas)
                </div>
            </div>
        </div>
    </div>
}

