@model List<AutoMarket.Models.Market.Reserva>

@{
    ViewData["Title"] = "Minhas Operações";

    var tipo = (ViewBag.Tipo as string) ?? "todos";

    int cReservas = ViewBag.CountReservas ?? 0;
    int cVisitas = ViewBag.CountVisitas ?? 0;
    int cEncomendas = ViewBag.CountEncomendas ?? 0;
    int cTodos = ViewBag.CountTodos ?? (cReservas + cVisitas + cEncomendas);
}

<style>
    .ops-tabs {
        display: flex;
        gap: 26px;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 14px;
        padding-bottom: 6px;
    }

        .ops-tabs a {
            padding: 12px 4px;
            text-decoration: none;
            color: #6b7280;
            font-weight: 650;
            border-bottom: 3px solid transparent;
        }

            .ops-tabs a.active {
                color: #111827;
                border-bottom-color: #111827;
            }
</style>

<div class="container mt-3">

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3 class="mb-0">Minhas Operações</h3>
        <a class="btn btn-dark" asp-action="Carros" asp-controller="Anuncios">Voltar aos carros</a>
    </div>

    @* Se quiseres, troca para uma key exclusiva só desta página, ex.: TempData["MsgOps"] *@
    @if (TempData["MsgOps"] != null)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center mb-3" role="alert">
            <span>@TempData["MsgOps"]</span>
            <button type="button" class="btn-close" aria-label="Fechar"
                    onclick="this.closest('.alert')?.remove();"></button>
        </div>
    }

    <!-- TABS (AJAX) -->
    <div class="ops-tabs" id="opsTabs">
        <a class="@(tipo == "reservas" ? "active" : "")"
           href="@Url.Action("_MinhasOperacoesConteudo", "Anuncios", new { tipo = "reservas" })"
           data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#opsContainer"
           data-ajax-success="amOpsInit">
            Reservas (@cReservas)
        </a>

        <a class="@(tipo == "visitas" ? "active" : "")"
           href="@Url.Action("_MinhasOperacoesConteudo", "Anuncios", new { tipo = "visitas" })"
           data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#opsContainer"
           data-ajax-success="amOpsInit">
            Visitas (@cVisitas)
        </a>

        <a class="@(tipo == "encomendas" ? "active" : "")"
           href="@Url.Action("_MinhasOperacoesConteudo", "Anuncios", new { tipo = "encomendas" })"
           data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#opsContainer"
           data-ajax-success="amOpsInit">
            Encomendas (@cEncomendas)
        </a>

        <a class="@(tipo == "todos" ? "active" : "")"
           href="@Url.Action("_MinhasOperacoesConteudo", "Anuncios", new { tipo = "todos" })"
           data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#opsContainer"
           data-ajax-success="amOpsInit">
            Todos (@cTodos)
        </a>
    </div>

    <!-- CONTEÚDO (Partial) -->
    <div id="opsContainer">
        <div class="text-center text-muted py-4">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">A carregar...</span>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // ✅ Carrega conteúdo via AJAX ao abrir a página
        $(function () {
            const tipo = "@(ViewBag.Tipo ?? "todos")";
            const url = "@Url.Action("_MinhasOperacoesConteudo", "Anuncios")";

            $("#opsContainer").load(url + "?tipo=" + encodeURIComponent(tipo), function(response, status, xhr) {
                if (status === "error") {
                    $(this).html('<div class="alert alert-danger">Erro ao carregar dados.</div>');
                } else if (window.amOpsInit) {
                    window.amOpsInit();
                }
            });
        });

        // ativa o tab visualmente ao clicar (sem depender do servidor)
        $(document).on('click', '#opsTabs a', function () {
            $('#opsTabs a').removeClass('active');
            $(this).addClass('active');
        });

        // ✅ (re)inicializa TODAS as secções (visitas/reservas/encomendas) quando o partial é carregado
        window.amOpsInit = function () {

            // ===== VISITAS =====
            const fv = document.getElementById("filtrosMinhasVisitas");
            if (fv && fv.dataset.bound !== "1") {
                fv.dataset.bound = "1";
                const ev = document.getElementById("minhasVisitasEstado");
                const ov = document.getElementById("minhasVisitasOrdem");

                // ✅ Garantir valor padrão "recent" se não estiver definido
                if (ov && !ov.value) ov.value = "recent";
    

                const submitV = () => { try { fv.requestSubmit(); } catch {} };
                if (ev) ev.addEventListener("change", submitV);
                if (ov) ov.addEventListener("change", submitV);
            }
            if (fv) { try { fv.requestSubmit(); } catch {} }

            // ===== RESERVAS =====
            const fr = document.getElementById("filtrosMinhasReservas");
            if (fr && fr.dataset.bound !== "1") {
                fr.dataset.bound = "1";
                const er = document.getElementById("minhasReservasEstado");
                const or = document.getElementById("minhasReservasOrdem");
                const submitR = () => { try { fr.requestSubmit(); } catch {} };
                if (er) er.addEventListener("change", submitR);
                if (or) or.addEventListener("change", submitR);
            }
            if (fr) { try { fr.requestSubmit(); } catch {} }

            // ===== ENCOMENDAS =====
            const fe = document.getElementById("filtrosMinhasEncomendas");
            if (fe && fe.dataset.bound !== "1") {
                fe.dataset.bound = "1";
                const ee = document.getElementById("minhasEncomendasEstado");
                const oe = document.getElementById("minhasEncomendasOrdem");
                const submitE = () => { try { fe.requestSubmit(); } catch {} };
                if (ee) ee.addEventListener("change", submitE);
                if (oe) oe.addEventListener("change", submitE);
            }
            if (fe) { try { fe.requestSubmit(); } catch {} }
        };

        // init ao abrir a página (para "todos" ou se o partial inicial tiver visitas)
        $(function () { window.amOpsInit(); });
    </script>
}