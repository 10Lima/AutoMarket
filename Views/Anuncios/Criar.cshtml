@using AutoMarket.Models.Market
@{
    ViewData["Title"] = "Criar anúncio";
    var marcas = ViewBag.Marcas as IEnumerable<Marca> ?? Enumerable.Empty<Marca>();
    
    // ✅ Modo editar
    var isEdit = (ViewBag.IsEdit as bool?) == true;
    var editId = (int?)(ViewBag.EditId ?? null);
    
    if (isEdit)
        ViewData["Title"] = "Editar anúncio";
}

<style>
  .img-grid{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:18px;
  }
  @@media (max-width:1200px){ .img-grid{ grid-template-columns:repeat(3,1fr);} }
  @@media (max-width:800px){ .img-grid{ grid-template-columns:repeat(2,1fr);} }

  .img-slot{
    border-radius:18px;
    overflow:hidden;
    aspect-ratio:4/3;
    background:#eeeeee;
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
  }

  /* placeholder com câmara (como na print) */
  .img-slot.empty::after{
    content:"📷";
    font-size:34px;
    opacity:.35;
  }

  /* slot preenchido */
  .img-slot.filled{ background:#f3f4f6; }
  .img-slot img{
    width:100%;
    height:100%;
    object-fit:cover;
    transform-origin:center center;
    user-select:none;
    -webkit-user-drag:none;
  }

  .principal-badge{
    position:absolute; left:0; bottom:0;
    padding:10px 14px;
    font-weight:800; font-size:13px;
    background:#26d7d0; color:#000;
    border-top-right-radius:12px;
    z-index:5;
  }

  .overlay{
    position:absolute; inset:0;
    display:flex; align-items:center; justify-content:center;
    gap:18px;
    opacity:0; transition:opacity .15s ease;
    background:rgba(0,0,0,.45);
    z-index:4;
  }
  .img-slot.filled:hover .overlay{ opacity:1; }

  .btn-round{
    width:58px; height:58px; border-radius:50%;
    border:none; cursor:pointer;
    background:rgba(255,255,255,.95);
    display:inline-flex; align-items:center; justify-content:center;
    font-size:26px;
  }

  /* add tile */
  .add-tile{
    background:#fbf6e9;
    cursor:pointer;
    flex-direction:column;
    gap:14px;
  }
  .add-text{ font-size:26px; font-weight:800; color:#0b2b2a; }
  .add-line{ width:70%; height:3px; background:#0b2b2a; border-radius:99px; opacity:.9; }

  .sortable-ghost{ opacity:.35; }
  .sortable-chosen{
    outline:3px solid rgba(91,157,255,.65);
    outline-offset:4px;
    border-radius:18px;
  }

  /* ✅ Campos auto-preenchidos: fundo cinzento */
  .autofill {
      background-color: #e9ecef !important;
      cursor: not-allowed;
      color: #495057;
  }

  /* ✅ Color swatch no Select2 */
  .color-swatch {
      display: inline-block;
      width: 20px;
      height: 20px;
      border-radius: 3px;
      margin-right: 8px;
      vertical-align: middle;
      border: 1px solid #ddd;
  }

  .img-block-title {
      font-size: 18px;
      font-weight: 600;
      margin-top: 20px;
      margin-bottom: 8px;
  }

  .img-block-sub {
      color: #6c757d;
      font-size: 14px;
      margin-bottom: 16px;
  }

  /* ✅ Slot amarelo dinâmico */
  .img-slot.add-tile{
    background:#fbf6e9;
    cursor:pointer;
    flex-direction:column;
    gap:14px;
  }
  .img-slot.add-tile::after{ content:""; } /* remove câmara no amarelo */

  .img-slot.add-tile .add-text{
    font-size:26px;
    font-weight:800;
    color:#0b2b2a;
  }
  .img-slot.add-tile .add-line{
    width:70%;
    height:3px;
    background:#0b2b2a;
    border-radius:99px;
    opacity:.9;
  }
</style>

<h1>@ViewData["Title"]</h1>

<form method="post"
      enctype="multipart/form-data"
      id="formCriarAnuncio"
      asp-controller="Anuncios"
      asp-action="@(isEdit ? "Editar" : "Criar")"
      asp-route-id="@(isEdit ? editId : null)">
    
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <!-- ========================================
         CASCATA: Marca → Modelo → Sub-Modelo
         ======================================== -->
    <div class="row">
        <div class="col-md-4">
            <label class="form-label">Marca</label>
            <select id="marcaSelect" name="id_marca" class="form-select">
                <option value="">— Marca —</option>
                @foreach (var m in marcas)
                {
                    <option value="@m.id_marca">@m.nome</option>
                }
            </select>
            <span class="text-danger">@Html.ValidationMessage("id_marca")</span>
        </div>

        <div class="col-md-4">
            <label class="form-label">Modelo</label>
            <select id="modeloSelect" name="id_modelo" class="form-select" disabled>
                <option value="">— Modelo —</option>
            </select>
            <span class="text-danger">@Html.ValidationMessage("id_modelo")</span>
        </div>

        <div class="col-md-4">
            <label class="form-label">Sub-modelo</label>
            <select id="subModeloSelect" name="id_sub_modelo" class="form-select" disabled>
                <option value="">— Sub-modelo —</option>
            </select>
            <span class="text-danger">@Html.ValidationMessage("id_sub_modelo")</span>
        </div>
    </div>

    <hr />

    <!-- ========================================
         ESPECIFICAÇÕES (auto-preenchidas)
         ======================================== -->
    <h5>Especificações (auto-preenchidas)</h5>
    <div class="row">
        <div class="col-md-3">
            <label class="form-label">Cilindrada</label>
            <input id="cilindrada" class="form-control autofill" readonly />
        </div>
        <div class="col-md-3">
            <label class="form-label">Potência (hp)</label>
            <input id="potencia" class="form-control autofill" readonly />
        </div>
        <div class="col-md-3">
            <label class="form-label">Combustível</label>
            <input id="combustivel" class="form-control autofill" readonly />
        </div>
        <div class="col-md-3">
            <label class="form-label">Caixa</label>
            <input id="caixa" class="form-control autofill" readonly />
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-md-3">
            <label class="form-label">Categoria</label>
            <input id="categoria" class="form-control autofill" readonly />
        </div>
    </div>

    <hr />

    <!-- ========================================
         DADOS DO ANÚNCIO (VERSÃO CORRIGIDA)
         ======================================== -->
    <h5>Dados do anúncio</h5>

    <div class="row">
        <!-- ✅ Ano: SEM required fixo -->
        <div class="col-md-3">
            <label class="form-label">Ano</label>
            <input name="ano" type="number" class="form-control" min="1900" max="2100" />
        </div>

        <!-- ✅ Quilometragem: SEM required fixo -->
        <div class="col-md-3">
            <label class="form-label">Quilometragem</label>
            <input name="quilometragem" type="number" class="form-control" min="0" />
        </div>

        <!-- ✅ Cor: SEM required fixo -->
        <div class="col-md-3">
            <label class="form-label">Cor</label>
            <select id="corSelect" name="cor" class="form-select">
                <option value="">— Cor —</option>
                <option value="Amarelo"  data-color="#FFD700">Amarelo</option>
                <option value="Azul"     data-color="#1E90FF">Azul</option>
                <option value="Bege"     data-color="#F5F5DC">Bege</option>
                <option value="Branco"   data-color="#FFFFFF">Branco</option>
                <option value="Castanho" data-color="#8B4513">Castanho</option>
                <option value="Cinzento" data-color="#808080">Cinzento</option>
                <option value="Dourado"  data-color="#D4AF37">Dourado</option>
                <option value="Laranja"  data-color="#FFA500">Laranja</option>
                <option value="Preto"    data-color="#000000">Preto</option>
                <option value="Prateado" data-color="#C0C0C0">Prateado</option>
                <option value="Rosa"     data-color="#FF69B4">Rosa</option>
                <option value="Roxo"     data-color="#800080">Roxo</option>
                <option value="Verde"    data-color="#008000">Verde</option>
                <option value="Vermelho" data-color="#FF0000">Vermelho</option>
            </select>
            <span class="text-danger">@Html.ValidationMessage("cor")</span>
        </div>

        <!-- ✅ Preço: SEM required fixo (só 1 input!) -->
        <div class="col-md-3">
            <label class="form-label">Preço (€)</label>
            <input name="preco" type="number" step="0.01" class="form-control" />
            <span class="text-danger">@Html.ValidationMessage("preco")</span>
        </div>
    </div>

    <!-- ✅ Prazo + Destaque -->
    <div class="row mt-3">
        <div class="col-md-3">
            <label class="form-label">Prazo de reserva</label>
            <select name="prazo_reserva_dias" class="form-select">
                <option value="1">1 dia (24h)</option>
                <option value="2">2 dias (48h)</option>
                <option value="3">3 dias (72h)</option>
                <option value="4">4 dias (96h)</option>
                <option value="5">5 dias (120h)</option>
                <option value="6">6 dias (144h)</option>
                <option value="7" selected>7 dias (168h)</option>
            </select>
        </div>

        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="destaque" value="true" id="destaqueChk" />
                <label class="form-check-label" for="destaqueChk">Destacar anúncio</label>
                <input type="hidden" name="destaque" value="false" />
            </div>
        </div>
    </div>

    <!-- ✅ Título: SEMPRE required -->
    <div class="mt-3">
        <label class="form-label">Título</label>
        <input name="titulo" class="form-control" required />
        <span class="text-danger">@Html.ValidationMessage("titulo")</span>
    </div>

    <!-- ✅ Localização: SEM required fixo -->
    <div class="mt-2">
        <label class="form-label">Localização</label>
        <input name="localizacao" class="form-control" />
        <span class="text-danger">@Html.ValidationMessage("localizacao")</span>
    </div>

    <!-- ✅ Descrição -->
    <div class="mt-2">
        <label class="form-label">Descrição</label>
        <textarea name="descricao" class="form-control" rows="4"></textarea>
    </div>

    <!-- ✅ BLOCO DE IMAGENS (12 SLOTS) -->
    <div class="img-block-title">Imagens</div>
    <div class="img-block-sub">
        A primeira imagem é a foto principal do teu anúncio. Arrasta e larga imagens para alterares a ordem.
    </div>

    <div id="imgGrid" class="img-grid">
        <div class="img-slot" data-slot="0"></div>
        <div class="img-slot" data-slot="1"></div>
        <div class="img-slot" data-slot="2"></div>
        <div class="img-slot" data-slot="3"></div>
        <div class="img-slot" data-slot="4"></div>
        <div class="img-slot" data-slot="5"></div>
        <div class="img-slot" data-slot="6"></div>
        <div class="img-slot" data-slot="7"></div>
        <div class="img-slot" data-slot="8"></div>
        <div class="img-slot" data-slot="9"></div>
        <div class="img-slot" data-slot="10"></div>
        <div class="img-slot" data-slot="11"></div>
    </div>

    <input id="imagens" name="imagens" type="file" accept="image/*" multiple hidden />
    <input type="hidden" id="imagensMeta" name="imagensMeta" value="[]" />
    <input type="hidden" id="imagensOrder" name="imagensOrder" value="" />

    <span class="text-danger">@Html.ValidationMessage("imagens")</span>

    <!-- ✅ DOIS BOTÕES -->
    <div class="mt-4">
        <button type="submit" name="submitAction" value="publicar" class="btn btn-primary">
            <i class="bi bi-check-circle"></i> Publicar anúncio
        </button>

        <button type="submit" name="submitAction" value="rascunho" class="btn btn-secondary ms-2">
            <i class="bi bi-save"></i> Guardar como rascunho
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // ✅ Dados do editar (JSON) - CORRIGIDO para evitar RuntimeBinderException
        @{
            var editDataObj = (object?)(ViewBag.EditData);
            var modelosObj = (object?)(ViewBag.Modelos ?? Array.Empty<object>());
            var submodelosObj = (object?)(ViewBag.SubModelos ?? Array.Empty<object>());
        }

        const editData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(editDataObj));
        const modelosPreload = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(modelosObj));
        const submodelosPreload = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(submodelosObj));

        // ========================================
        // SELECT2 + CASCATA
        // ========================================
        function initSelect2($el, placeholder) {
            $el.select2({
                theme: "default",
                width: "100%",
                placeholder: placeholder,
                allowClear: true
            });
        }

        function resetSelect2($el, placeholderText) {
            if ($el.data("select2")) $el.select2("destroy");
            $el.empty().append($("<option>").val("").text(placeholderText));
            $el.prop("disabled", true);
            initSelect2($el, placeholderText);
            $el.trigger("change.select2");
        }

        function clearSpecs() {
            $("#cilindrada,#potencia,#combustivel,#caixa,#categoria").val("");
        }

        async function loadJson(url) {
            const r = await fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } });
            if (!r.ok) return null;
            return await r.json();
        }

        function formatColor(opt) {
            if (!opt.id) return opt.text;
            const color = $(opt.element).data("color");
            if (!color) return opt.text;

            const $swatch = $("<span>").addClass("color-swatch").css("background-color", color);
            const $text = $("<span>").text(opt.text);
            return $("<span>").append($swatch).append($text);
        }

        $(function () {
            const $marca = $("#marcaSelect");
            const $modelo = $("#modeloSelect");
            const $sub = $("#subModeloSelect");
            const $cor = $("#corSelect");

            initSelect2($marca, "— Marca —");
            initSelect2($modelo, "— Modelo —");
            initSelect2($sub, "— Sub-modelo —");

            $cor.select2({
                width: "100%",
                placeholder: "— Cor —",
                allowClear: true,
                templateResult: formatColor,
                templateSelection: formatColor
            });

            $modelo.prop("disabled", true).trigger("change.select2");
            $sub.prop("disabled", true).trigger("change.select2");

            // ✅ PREENCHER NO MODO EDITAR
            if (editData) {
                // Marca
                $marca.val(String(editData.id_marca)).trigger("change.select2");

                // Modelos preload
                resetSelect2($modelo, "— Modelo —");
                for (const it of modelosPreload) {
                    $modelo.append($("<option>").val(it.id_modelo).text(it.nome));
                }
                $modelo.prop("disabled", false);
                initSelect2($modelo, "— Modelo —");
                $modelo.val(String(editData.id_modelo)).trigger("change.select2");

                // SubModelos preload
                resetSelect2($sub, "— Sub-modelo —");
                for (const it of submodelosPreload) {
                    $sub.append($("<option>").val(it.id_sub_modelo).text(it.nome));
                }
                $sub.prop("disabled", false);
                initSelect2($sub, "— Sub-modelo —");
                
                // ✅ CORREÇÃO: Dispara "change" E "change.select2" para preencher specs
                $sub.val(String(editData.id_sub_modelo))
                    .trigger("change.select2")
                    .trigger("change"); // ✅ Isto dispara o handler que carrega specs!

                // Campos
                $("input[name='ano']").val(editData.ano);
                $("input[name='quilometragem']").val(editData.quilometragem);
                $cor.val(editData.cor).trigger("change.select2");
                $("input[name='titulo']").val(editData.titulo);
                $("textarea[name='descricao']").val(editData.descricao);
                $("input[name='localizacao']").val(editData.localizacao);
                $("input[name='preco']").val(editData.preco);

                // Prazo (vem em horas)
                const dias = Math.max(1, Math.min(7, Math.round(editData.prazo_reserva_horas / 24)));
                $("select[name='prazo_reserva_dias']").val(String(dias));

                // Destaque
                $("#destaqueChk").prop("checked", !!editData.destaque);
            }

            $marca.on("change", async function () {
                clearSpecs();
                resetSelect2($modelo, "— Modelo —");
                resetSelect2($sub, "— Sub-modelo —");

                const idMarca = $(this).val();
                if (!idMarca) return;

                const list = await loadJson(`@Url.Action("GetModelos","Anuncios")?idMarca=${idMarca}`);
                const items = list ?? [];

                for (const it of items) {
                    $modelo.append($("<option>").val(it.id_modelo).text(it.nome));
                }

                $modelo.prop("disabled", false);
                initSelect2($modelo, "— Modelo —");
                $modelo.trigger("change.select2");
            });

            $modelo.on("change", async function () {
                clearSpecs();
                resetSelect2($sub, "— Sub-modelo —");

                const idModelo = $(this).val();
                if (!idModelo) return;

                const list = await loadJson(`@Url.Action("GetSubModelos","Anuncios")?idModelo=${idModelo}`);
                const items = list ?? [];

                for (const it of items) {
                    $sub.append($("<option>").val(it.id_sub_modelo).text(it.nome));
                }

                $sub.prop("disabled", false);
                initSelect2($sub, "— Sub-modelo —");
                $sub.trigger("change.select2");
            });

            $sub.on("change", async function () {
                clearSpecs();
                const idSub = $(this).val();
                if (!idSub) return;

                const s = await loadJson(`@Url.Action("GetSpecs","Anuncios")?idSubModelo=${idSub}`);
                if (!s) return;

                $("#cilindrada").val(s.cilindrada ?? "");
                $("#potencia").val(s.potencia_hp ?? "");
                $("#combustivel").val(s.combustivel ?? "");
                $("#caixa").val(s.caixa ?? "");
                $("#categoria").val(s.categoria ?? "");
            });
        });

        // ========================================
        // ✅ IMAGENS: GRID COM TILE AMARELO DINÂMICO
        // ========================================
        (function () {
          const grid = document.getElementById("imgGrid");
          const input = document.getElementById("imagens");
          const orderHidden = document.getElementById("imagensOrder");

          const slots = Array.from(grid.querySelectorAll(".img-slot"));
          const MAX = slots.length;

          let items = [];

          function sameFile(a,b){
            return a.name===b.name && a.size===b.size && a.lastModified===b.lastModified;
          }

          function syncFilesAndOrder(){
            const dt = new DataTransfer();
            let newCounter = 0;
            const tokens = [];

            for(const it of items){
              if(it.kind==="db"){
                tokens.push(`db:${it.dbId}`);
              } else {
                dt.items.add(it.file);
                tokens.push(`new:${newCounter++}`);
              }
            }

            input.files = dt.files;
            orderHidden.value = tokens.join(",");
          }

          function clearSlot(slot){
            slot.className = "img-slot";
            slot.innerHTML = "";
            slot.dataset.itemId = "";
          }

          function setPrincipalBadge(slot){
            const badge = document.createElement("div");
            badge.className = "principal-badge";
            badge.textContent = "PRINCIPAL";
            slot.appendChild(badge);
          }

          function fillSlot(slot, it){
            slot.classList.add("filled");
            slot.dataset.itemId = it.id;

            const img = document.createElement("img");
            img.src = it.url;
            img.draggable = false;
            img.style.transform = `rotate(${it.rotation || 0}deg)`;

            const overlay = document.createElement("div");
            overlay.className = "overlay";

            const btnRotate = document.createElement("button");
            btnRotate.type = "button";
            btnRotate.className = "btn-round";
            btnRotate.title = "Rodar 90º";
            btnRotate.innerHTML = "⟲";
            btnRotate.addEventListener("click", (e) => {
              e.stopPropagation();
              it.rotation = ((it.rotation || 0) + 90) % 360;
              img.style.transform = `rotate(${it.rotation}deg)`;
            });

            const btnDelete = document.createElement("button");
            btnDelete.type = "button";
            btnDelete.className = "btn-round";
            btnDelete.title = "Eliminar";
            btnDelete.innerHTML = "🗑️";
            btnDelete.addEventListener("click", (e) => {
              e.stopPropagation();
              items = items.filter(x => x.id !== it.id);
              try { if (it.kind === "new") URL.revokeObjectURL(it.url); } catch {}
              render();
            });

            overlay.appendChild(btnRotate);
            overlay.appendChild(btnDelete);

            slot.appendChild(img);
            slot.appendChild(overlay);
          }

          function markAddTile(slot){
            slot.classList.add("add-tile");
            const t = document.createElement("div");
            t.className = "add-text";
            t.textContent = "Adicionar imagem";
            const line = document.createElement("div");
            line.className = "add-line";
            slot.appendChild(t);
            slot.appendChild(line);
          }

          function render(){
            for(const s of slots) clearSlot(s);

            const slice = items.slice(0, MAX);
            slice.forEach((it, idx) => fillSlot(slots[idx], it));

            if(slice.length > 0) setPrincipalBadge(slots[0]);

            const nextIdx = slice.length;
            if(nextIdx < MAX){
              slots[nextIdx].classList.add("empty");
              markAddTile(slots[nextIdx]);
            }

            for(let i = nextIdx + 1; i < MAX; i++){
              slots[i].classList.add("empty");
            }

            syncFilesAndOrder();
          }

          function addNewFiles(fileArray){
            const arr = Array.from(fileArray || []);
            for(const f of arr){
              if(!f || f.size===0) continue;
              if(!f.type.startsWith("image/")) continue;
              if(items.length >= MAX) break;

              if(items.some(it => it.kind==="new" && sameFile(it.file, f))) continue;

              items.push({
                id: (crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}_${Math.random()}`),
                kind: "new",
                file: f,
                url: URL.createObjectURL(f),
                rotation: 0
              });
            }
            render();
          }

          function addExisting(list){
            for(const img of (list || [])){
              if(items.length >= MAX) break;
              items.push({
                id: "db_" + img.id,
                kind: "db",
                dbId: img.id,
                file: null,
                url: img.url,
                rotation: img.rotation || 0
              });
            }
            render();
          }

          grid.addEventListener("click", (e) => {
            const slot = e.target.closest(".img-slot");
            if(!slot) return;
            if(slot.classList.contains("filled")) return;
            input.click();
          });

          input.addEventListener("change", () => {
            const picked = input.files ? Array.from(input.files) : [];
            input.value = "";
            if(picked.length) addNewFiles(picked);
          });

          ["dragenter","dragover"].forEach(evt =>
            grid.addEventListener(evt, (e)=>{ e.preventDefault(); e.stopPropagation(); })
          );
          grid.addEventListener("drop", (e)=>{
            e.preventDefault(); e.stopPropagation();
            if(e.dataTransfer && e.dataTransfer.files) addNewFiles(e.dataTransfer.files);
          });

          new Sortable(grid, {
            animation: 150,
            draggable: ".img-slot.filled",
            filter: ".img-slot:not(.filled)",
            ghostClass: "sortable-ghost",
            chosenClass: "sortable-chosen",
            forceFallback: true,
            fallbackOnBody: true,
            onEnd: function () {
              const ordered = [];
              for(const s of slots){
                if(!s.classList.contains("filled")) continue;
                const id = s.dataset.itemId;
                const it = items.find(x => x.id === id);
                if(it) ordered.push(it);
              }
              items = ordered;
              render();
            }
          });

          const form = document.getElementById("formCriarAnuncio");
          if(form) form.addEventListener("submit", () => syncFilesAndOrder());

          if (typeof editData !== "undefined" && editData && editData.imagens) {
            addExisting(editData.imagens);
          } else {
            render();
          }
        })();
    </script>

    <script>
        // ========================================
        // ✅ VALIDAÇÃO DINÂMICA: required só ao PUBLICAR
        // ========================================
        (function () {
            const form = document.getElementById("formCriarAnuncio");
            if (!form) return;

            const btnPublicar = form.querySelector("button[name='submitAction'][value='publicar']");
            const btnRascunho = form.querySelector("button[name='submitAction'][value='rascunho']");

            const setPublishRequired = (isPublish) => {
                // ✅ Título: SEMPRE obrigatório
                const titulo = form.querySelector("input[name='titulo']");
                if (titulo) titulo.setAttribute("required", "required");

                // ✅ Só obrigatório ao publicar
                const camposPublicar = ["preco", "localizacao", "cor", "ano", "quilometragem"];

                camposPublicar.forEach(name => {
                    const el = form.querySelector(`[name='${name}']`);
                    if (!el) return;

                    if (isPublish) {
                        el.setAttribute("required", "required");
                    } else {
                        el.removeAttribute("required");
                    }
                });
            };

            // ✅ Ao clicar "Publicar" → activa validação
            if (btnPublicar) {
                btnPublicar.addEventListener("click", () => {
                    setPublishRequired(true);
                });
            }

            // ✅ Ao clicar "Rascunho" → desativa validação
            if (btnRascunho) {
                btnRascunho.addEventListener("click", () => {
                    setPublishRequired(false);
                });
            }

            // ✅ Default ao carregar: modo rascunho (sem required nos opcionais)
            setPublishRequired(false);
        })();
    </script>
}