@using Microsoft.EntityFrameworkCore
@using AutoMarket.Services
@using System.Text.Json
@using Microsoft.AspNetCore.Identity
@inject CurrentUserService CurrentUser
@inject AutoMarket.Data.MarketplaceDbContext MarketDb
@inject AutoMarket.Data.ApplicationDbContext IdentityDb

@model AutoMarket.Models.Market.Anuncio

@{
    ViewData["Title"] = Model.titulo ?? "Detalhes do anúncio";

    var veiculo = Model.id_veiculoNavigation;
    var subModelo = veiculo?.id_sub_modeloNavigation;
    var modelo = subModelo?.id_modeloNavigation;
    var marca = modelo?.id_marcaNavigation;

    var imagens = Model.Anuncio_Imagem?
        .OrderByDescending(x => x.principal)
        .ThenBy(x => x.ordem ?? 9999)
        .Select(x => x.id_imagem_anuncioNavigation?.url)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList() ?? new List<string>();

    var primeiraImagem = imagens.FirstOrDefault();

    // ✅ Lógica de autorização/permissões
    bool isAuth = User?.Identity?.IsAuthenticated ?? false;
    int? idUtil = null;

    if (isAuth)
        idUtil = await CurrentUser.GetMarketUserIdAsync(User);

    bool isOwner = (idUtil != null && idUtil.Value == Model.id_vendedor);

    bool isComprador = false;
    if (idUtil != null && !isOwner)
        isComprador = await MarketDb.Comprador.AnyAsync(c => c.id_utilizador == idUtil.Value);

    // ✅ NOVA: Verificar se já existe visita pendente/agendada
    long? myVisitaId = null;
    DateTime? myVisitaLocal = null;
    string? myVisitaEstado = null;

    if (isComprador && idUtil != null)
    {
        var v = await MarketDb.Visita
            .AsNoTracking()
            .Where(x => x.id_anuncio == Model.id_anuncio
                     && x.id_utilizador == idUtil.Value
                     && (x.estado == "pendente" || x.estado == "agendada"))
            .OrderByDescending(x => x.data_visita)
            .Select(x => new { x.id_visita, x.data_visita, x.estado })
            .FirstOrDefaultAsync();

        if (v != null)
        {
            myVisitaId = v.id_visita;
            myVisitaLocal = v.data_visita.ToLocalTime();
            myVisitaEstado = v.estado;
        }
    }

    bool showActions = !isOwner;

    bool hasMyActiveReserva = false;
    long? myReservaId = null;

    if (isComprador && idUtil != null)
    {
        var myRes = await MarketDb.Reserva
            .AsNoTracking()
            .Where(r => r.id_anuncio == Model.id_anuncio
                     && r.id_utilizador == idUtil.Value
                     && r.estado == "ativa")
            .Select(r => new { r.id_reserva })
            .FirstOrDefaultAsync();

        if (myRes != null)
        {
            hasMyActiveReserva = true;
            myReservaId = myRes.id_reserva;
        }
    }

    bool isReservado = string.Equals(Model.estado, "reservado", StringComparison.OrdinalIgnoreCase);
    bool isAtivo = string.Equals(Model.estado, "ativo", StringComparison.OrdinalIgnoreCase);
    bool isVendido = string.Equals(Model.estado, "vendido", StringComparison.OrdinalIgnoreCase);

    DateTime? reservaExpiraEm = null;

    if (isReservado)
    {
        reservaExpiraEm = await MarketDb.Reserva
            .AsNoTracking()
            .Where(r => r.id_anuncio == Model.id_anuncio && r.estado == "ativa")
            .Select(r => r.data_expiracao)
            .FirstOrDefaultAsync();
    }

    string vendedorUsername = "—";
    string vendedorEmail = "—";

    var vendedorIdentityId = await MarketDb.Utilizador
        .AsNoTracking()
        .Where(u => u.id_utilizador == Model.id_vendedor)
        .Select(u => u.identity_user_id)
        .FirstOrDefaultAsync();

    if (!string.IsNullOrWhiteSpace(vendedorIdentityId))
    {
        var u = await IdentityDb.Users
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.Id == vendedorIdentityId);

        if (u != null)
        {
            vendedorUsername = string.IsNullOrWhiteSpace(u.UserName) ? "—" : u.UserName!;
            vendedorEmail = string.IsNullOrWhiteSpace(u.Email) ? "—" : u.Email!;
        }
    }

    var contactosVendedor = await MarketDb.Utilizador_Contacto
        .AsNoTracking()
        .Where(c => c.id_utilizador == Model.id_vendedor)
        .OrderBy(c => c.id_contacto)
        .Select(c => new { c.tipo, c.valor })
        .Take(2)
        .ToListAsync();

    var c1 = contactosVendedor.ElementAtOrDefault(0);
    var c2 = contactosVendedor.ElementAtOrDefault(1);

    // ✅ NOVO: Verificar encomendas pendente/paga
    bool hasMyEncomendaPendente = false;
    long? myEncomendaPendenteId = null;
    bool hasMyEncomendaPaga = false;

    if (isComprador && idUtil != null)
    {
        var enc = await MarketDb.Encomenda
            .AsNoTracking()
            .Where(e => e.id_anuncio == Model.id_anuncio
                     && e.id_utilizador == idUtil.Value
                     && (e.estado == "pendente" || e.estado == "pago"))
            .OrderByDescending(e => e.data_encomenda)
            .Select(e => new { e.id_encomenda, e.estado })
            .FirstOrDefaultAsync();

        if (enc != null)
        {
            if (enc.estado == "pendente")
            {
                hasMyEncomendaPendente = true;
                myEncomendaPendenteId = enc.id_encomenda;
            }
            else if (enc.estado == "pago")
            {
                hasMyEncomendaPaga = true;
            }
        }
    }
}

<div class="container-xl ad-details">
    <div class="row g-4">
        <!-- COLUNA ESQUERDA: Galeria + Info -->
        <div class="col-8">

            <!-- ✅ GALERIA -->
            <div class="card mb-3">
                <div class="card-body p-0">
                    @if (!string.IsNullOrWhiteSpace(primeiraImagem))
                    {
                        <div class="am-gallery-media" style="aspect-ratio: 16/10;">
                            <img id="mainImg"
                                 src="@primeiraImagem"
                                 alt="@Model.titulo"
                                 style="width: 100%; height: 100%; object-fit: cover; transition: opacity 0.15s;" />

                            @if (imagens.Count > 1)
                            {
                                <button type="button"
                                        id="imgPrev"
                                        class="am-img-nav am-prev"
                                        aria-label="Imagem anterior">
                                    &lt;
                                </button>

                                <button type="button"
                                        id="imgNext"
                                        class="am-img-nav am-next"
                                        aria-label="Imagem seguinte">
                                    &gt;
                                </button>

                                <div class="img-counter">
                                    <span id="imgIndex">1</span> / @imagens.Count
                                </div>
                            }
                        </div>

                        @if (imagens.Count > 1)
                        {
                            <div class="thumb-grid" id="thumbsRow" aria-label="Miniaturas do anúncio">
                                @for (int i = 0; i < imagens.Count; i++)
                                {
                                    var img = imagens[i];
                                    <div class="thumb @(i == 0 ? "active" : "")"
                                         data-idx="@i"
                                         data-src="@img">
                                        <img src="@img" alt="Miniatura @(i + 1)" />
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-image" style="font-size: 4rem;"></i>
                            <p class="mt-2">Sem imagens</p>
                        </div>
                    }
                </div>
            </div>

            <!-- ✅ INFORMAÇÕES DO VEÍCULO -->
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Informações do veículo</h5>
                </div>
                <div class="card-body">
                    <div class="spec-grid">
                        <div>
                            <strong>Marca</strong>
                            <span>@(marca?.nome ?? "—")</span>
                        </div>
                        <div>
                            <strong>Modelo</strong>
                            <span>@(modelo?.nome ?? "—")</span>
                        </div>
                        <div>
                            <strong>Sub-modelo</strong>
                            <span>@(subModelo?.nome ?? "—")</span>
                        </div>
                        <div>
                            <strong>Ano</strong>
                            <span>@(veiculo?.ano?.ToString() ?? "—")</span>
                        </div>
                        <div>
                            <strong>Quilómetros</strong>
                            <span>@(veiculo?.quilometragem?.ToString("N0") ?? "—") km</span>
                        </div>
                        <div>
                            <strong>Cor</strong>
                            <span>@(veiculo?.cor ?? "—")</span>
                        </div>
                        <div>
                            <strong>Combustível</strong>
                            <span>@(subModelo?.combustivel ?? "—")</span>
                        </div>
                        <div>
                            <strong>Caixa</strong>
                            <span>@(subModelo?.caixa ?? "—")</span>
                        </div>
                        <div>
                            <strong>Potência</strong>
                            <span>@(subModelo?.potencia_hp > 0 ? $"{subModelo.potencia_hp} cv" : "—")</span>
                        </div>
                        <div>
                            <strong>Cilindrada</strong>
                            <span>@(subModelo?.cilindrada > 0 ? $"{subModelo.cilindrada} cm³" : "—")</span>
                        </div>
                        <div>
                            <strong>Categoria</strong>
                            <span>@(subModelo?.categoria ?? "—")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ✅ DESCRIÇÃO -->
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-text-paragraph"></i> Descrição</h5>
                </div>
                <div class="card-body">
                    <p style="white-space: pre-wrap;" class="mb-0">
                        @(string.IsNullOrWhiteSpace(Model.descricao) ? "Sem descrição." : Model.descricao)
                    </p>
                </div>
            </div>
        </div>

        <!-- COLUNA DIREITA: Preço + Ações (sticky) -->
        <div class="col-4">
            <div class="sticky-side">

                <!-- ✅ PREÇO E INFO -->
                <div class="card mb-3">
                    <div class="card-body">
                        <h3 class="mb-3">
                            @(Model.preco.HasValue ? $"{Model.preco.Value:N0} €" : "Preço não disponível")
                        </h3>

                        <div class="meta-list">
                            <div class="meta-item">
                                <i class="bi bi-tag"></i>
                                <div>
                                    <div class="label">Estado</div>
                                    <div class="value">
                                        @switch (Model.estado?.ToLowerInvariant())
                                        {
                                            case "ativo":
                                                <span class="badge bg-success">Ativo</span>
                                                break;
                                            case "reservado":
                                                <span class="badge bg-warning text-dark">Reservado</span>
                                                break;
                                            case "vendido":
                                                <span class="badge bg-secondary">Vendido</span>
                                                break;
                                            case "inativo":
                                                <span class="badge bg-secondary">Inativo</span>
                                                break;
                                            case "rascunho":
                                                <span class="badge bg-secondary">Rascunho</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@Model.estado</span>
                                                break;
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (isReservado && reservaExpiraEm.HasValue)
                            {
                                <div class="meta-item">
                                    <i class="bi bi-clock"></i>
                                    <div>
                                        <div class="label">Reserva expira em</div>
                                        <div class="value">@reservaExpiraEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                </div>
                            }

                            <div class="meta-item">
                                <i class="bi bi-geo-alt"></i>
                                <div>
                                    <div class="label">Localização</div>
                                    <div class="value">@(Model.localizacao ?? "—")</div>
                                </div>
                            </div>

                            <div class="meta-item">
                                <i class="bi bi-hourglass-split"></i>
                                <div>
                                    <div class="label">Prazo de reserva</div>
                                    <div class="value">@Model.prazo_reserva horas (@(Model.prazo_reserva / 24) dia@(Model.prazo_reserva > 24 ? "s" : ""))</div>
                                </div>
                            </div>

                            @if (Model.destaque)
                            {
                                <div class="meta-item">
                                    <i class="bi bi-star-fill"></i>
                                    <div>
                                        <div class="value">
                                            <span class="badge bg-warning text-dark">Anúncio em destaque</span>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="meta-item">
                                <i class="bi bi-calendar"></i>
                                <div>
                                    <div class="label">Publicado em</div>
                                    <div class="value">
                                        @(Model.data_publicacao.HasValue
                                                                                ? Model.data_publicacao.Value.ToString("dd/MM/yyyy HH:mm")
                                                                                : "—")
                                    </div>
                                </div>
                            </div>

                            <div class="meta-item">
                                <i class="bi bi-arrow-repeat"></i>
                                <div>
                                    <div class="label">Última atualização</div>
                                    <div class="value">
                                        @(Model.data_atualizacao.HasValue
                                                                                ? Model.data_atualizacao.Value.ToString("dd/MM/yyyy HH:mm")
                                                                                : "—")
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-3" />
                        <div>
                            <h6 class="text-uppercase text-muted small mb-2">
                                <i class="bi bi-person-lines-fill"></i> Vendedor
                            </h6>

                            <div class="mb-2">
                                <strong>@vendedorUsername</strong>
                            </div>

                            @if (vendedorEmail != "—")
                            {
                                <div class="mb-2">
                                    <i class="bi bi-envelope"></i>
                                    <a href="mailto:@vendedorEmail">@vendedorEmail</a>
                                </div>
                            }
                            else
                            {
                                <div class="mb-2 text-muted">
                                    <i class="bi bi-envelope"></i> —
                                </div>
                            }

                            @if (c1 != null && !string.IsNullOrWhiteSpace(c1.valor))
                            {
                                <div class="mb-2">
                                    <i class="bi bi-telephone"></i>
                                    @c1.valor
                                </div>
                            }

                            @if (c2 != null && !string.IsNullOrWhiteSpace(c2.valor))
                            {
                                <div>
                                    <i class="bi bi-telephone"></i>
                                    @c2.valor
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- ✅ AÇÕES (Reservar/Agendar/Comprar) -->
                @if (showActions)
                {
                    <div class="card">
                        <div class="card-body">
                            @if (!isAuth)
                            {
                                var returnUrl = Url.Action("Detalhes", "Anuncios", new { id = Model.id_anuncio });

                                <div class="d-grid gap-2">
                                    <a class="btn-am btn-am-outline"
                                       asp-area="Identity" asp-page="/Account/Login"
                                       asp-route-returnUrl="@returnUrl">
                                        <i class="bi bi-bookmark"></i> Reservar
                                    </a>

                                    <a class="btn-am btn-am-ghost"
                                       asp-area="Identity" asp-page="/Account/Login"
                                       asp-route-returnUrl="@returnUrl">
                                        <i class="bi bi-calendar-check"></i> Agendar Visita
                                    </a>

                                    <a class="btn-am btn-am-solid"
                                       asp-area="Identity" asp-page="/Account/Login"
                                       asp-route-returnUrl="@returnUrl">
                                        <i class="bi bi-cart-check"></i> Comprar
                                    </a>
                                </div>
                            }
                            else if (isComprador)
                            {
                                if (isReservado && hasMyActiveReserva && myReservaId != null)
                                {
                                    <div class="d-grid gap-2">
                                        <form asp-action="CancelarReserva" asp-controller="Anuncios" method="post"
                                              onsubmit="return confirm('Tens a certeza que queres cancelar a reserva?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idReserva" value="@myReservaId" />
                                            <button class="btn btn-outline-danger btn-lg w-100" type="submit">
                                                <i class="bi bi-x-circle"></i> Cancelar Reserva
                                            </button>
                                        </form>

                                        <!-- ✅ Slot DINÂMICO (mostra visita existente ou botão Agendar) -->
                                        <div id="agendarSlot_@Model.id_anuncio" class="agendar-slot">
                                            @if (myVisitaId != null && myVisitaLocal.HasValue && (myVisitaEstado == "pendente" || myVisitaEstado == "agendada"))
                                            {
                                                var isAgendada = myVisitaEstado == "agendada";
                                                var titulo = isAgendada ? "Pedido aceite" : "Pedido submetido";
                                                var estadoUi = isAgendada ? "Agendada" : "pendente";
                                                var labelData = isAgendada ? "Data visita" : "Data proposta";
                                                var dataTxt = myVisitaLocal.Value.ToString("dd/MM/yyyy HH:mm");

                                                <div class="alert alert-success border mb-0">
                                                    <h6 class="mb-1">
                                                        <i class="bi bi-check-circle-fill"></i> @titulo
                                                    </h6>

                                                    <div class="small text-muted mb-3">
                                                        Estado: <strong>@estadoUi</strong> · @labelData: <strong>@dataTxt</strong>
                                                    </div>

                                                    <form asp-controller="Visitas" asp-action="CancelarDetalhe" method="post"
                                                          data-ajax="true"
                                                          data-ajax-method="POST"
                                                          data-ajax-update="#agendarSlot_@Model.id_anuncio"
                                                          data-ajax-mode="replace"
                                                          onsubmit="return confirm('Cancelar esta visita?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="idVisita" value="@myVisitaId" />
                                                        <input type="hidden" name="idAnuncio" value="@Model.id_anuncio" />

                                                        <button class="btn-am btn-am-outline w-100" type="submit">
                                                            <i class="bi bi-x-circle"></i> Cancelar Visita a @dataTxt
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <form asp-controller="Visitas" asp-action="FormAgendar" method="get"
                                                      data-ajax="true"
                                                      data-ajax-method="GET"
                                                      data-ajax-update="#agendarSlot_@Model.id_anuncio"
                                                      data-ajax-mode="replace">
                                                    <input type="hidden" name="idAnuncio" value="@Model.id_anuncio" />
                                                    <button class="btn-am btn-am-ghost w-100" type="submit">
                                                        <i class="bi bi-calendar-check"></i> Agendar Visita
                                                    </button>
                                                </form>
                                            }
                                        </div>

                                        @* ✅ ENCOMENDA: pendente/paga/normal *@
                                        @if (hasMyEncomendaPendente && myEncomendaPendenteId != null)
                                        {
                                            var returnUrl = Url.Action("Detalhes", "Anuncios", new { id = Model.id_anuncio });

                                            <a class="btn-am btn-am-solid w-100"
                                               asp-controller="Encomendas"
                                               asp-action="Carrinho">
                                                <i class="bi bi-cart"></i> Ir para o carrinho
                                            </a>

                                            <form asp-controller="Encomendas" asp-action="Cancelar" method="post"
                                                  onsubmit="return confirm('Cancelar esta encomenda?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@myEncomendaPendenteId" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />

                                                <button class="btn btn-outline-danger btn-lg w-100" type="submit">
                                                    <i class="bi bi-x-circle"></i> Cancelar encomenda
                                                </button>
                                            </form>
                                        }
                                        else if (hasMyEncomendaPaga)
                                        {
                                            <button class="btn-am btn-am-solid w-100" type="button" disabled>
                                                <i class="bi bi-check2-circle"></i> Já comprado
                                            </button>
                                        }
                                        else
                                        {
                                            <form asp-controller="Encomendas" asp-action="Adicionar" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idAnuncio" value="@Model.id_anuncio" />
                                                <button class="btn-am btn-am-solid w-100" type="submit">
                                                    <i class="bi bi-cart-check"></i> Comprar
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                                else if (isAtivo)
                                {
                                    <div class="d-grid gap-2">
                                        <form asp-action="Reservar" asp-controller="Anuncios" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idAnuncio" value="@Model.id_anuncio" />
                                            <button class="btn-am btn-am-outline w-100" type="submit">
                                                <i class="bi bi-bookmark"></i> Reservar
                                            </button>
                                        </form>

                                        <!-- ✅ Slot DINÂMICO (mostra visita existente ou botão Agendar) -->
                                        <div id="agendarSlot_@Model.id_anuncio" class="agendar-slot">
                                            @if (myVisitaId != null && myVisitaLocal.HasValue && (myVisitaEstado == "pendente" || myVisitaEstado == "agendada"))
                                            {
                                                var isAgendada = myVisitaEstado == "agendada";
                                                var titulo = isAgendada ? "Pedido aceite" : "Pedido submetido";
                                                var estadoUi = isAgendada ? "Agendada" : "pendente";
                                                var labelData = isAgendada ? "Data visita" : "Data proposta";
                                                var dataTxt = myVisitaLocal.Value.ToString("dd/MM/yyyy HH:mm");

                                                <div class="alert alert-success border mb-0">
                                                    <h6 class="mb-1">
                                                        <i class="bi bi-check-circle-fill"></i> @titulo
                                                    </h6>

                                                    <div class="small text-muted mb-3">
                                                        Estado: <strong>@estadoUi</strong> · @labelData: <strong>@dataTxt</strong>
                                                    </div>

                                                    <form asp-controller="Visitas" asp-action="CancelarDetalhe" method="post"
                                                          data-ajax="true"
                                                          data-ajax-method="POST"
                                                          data-ajax-update="#agendarSlot_@Model.id_anuncio"
                                                          data-ajax-mode="replace"
                                                          onsubmit="return confirm('Cancelar esta visita?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="idVisita" value="@myVisitaId" />
                                                        <input type="hidden" name="idAnuncio" value="@Model.id_anuncio" />

                                                        <button class="btn-am btn-am-outline w-100" type="submit">
                                                            <i class="bi bi-x-circle"></i> Cancelar Visita a @dataTxt
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <form asp-controller="Visitas" asp-action="FormAgendar" method="get"
                                                      data-ajax="true"
                                                      data-ajax-method="GET"
                                                      data-ajax-update="#agendarSlot_@Model.id_anuncio"
                                                      data-ajax-mode="replace">
                                                    <input type="hidden" name="idAnuncio" value="@Model.id_anuncio" />
                                                    <button class="btn-am btn-am-ghost w-100" type="submit">
                                                        <i class="bi bi-calendar-check"></i> Agendar Visita
                                                    </button>
                                                </form>
                                            }
                                        </div>

                                        @* ✅ ENCOMENDA: pendente/paga/normal *@
                                        @if (hasMyEncomendaPendente && myEncomendaPendenteId != null)
                                        {
                                            var returnUrl = Url.Action("Detalhes", "Anuncios", new { id = Model.id_anuncio });

                                            <a class="btn-am btn-am-solid w-100"
                                               asp-controller="Encomendas"
                                               asp-action="Carrinho">
                                                <i class="bi bi-cart"></i> Ir para o carrinho
                                            </a>

                                            <form asp-controller="Encomendas" asp-action="Cancelar" method="post"
                                                  onsubmit="return confirm('Cancelar esta encomenda?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@myEncomendaPendenteId" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />

                                                <button class="btn btn-outline-danger btn-lg w-100" type="submit">
                                                    <i class="bi bi-x-circle"></i> Cancelar encomenda
                                                </button>
                                            </form>
                                        }
                                        else if (hasMyEncomendaPaga)
                                        {
                                            <button class="btn-am btn-am-solid w-100" type="button" disabled>
                                                <i class="bi bi-check2-circle"></i> Já comprado
                                            </button>
                                        }
                                        else
                                        {
                                            <form asp-controller="Encomendas" asp-action="Adicionar" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idAnuncio" value="@Model.id_anuncio" />
                                                <button class="btn-am btn-am-solid w-100" type="submit">
                                                    <i class="bi bi-cart-check"></i> Comprar
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning mb-0">
                                        <i class="bi bi-exclamation-triangle"></i>
                                        Este anúncio não está disponível para compra/reserva.
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    <i class="bi bi-exclamation-triangle"></i> Precisa de ser comprador para aceder a estas ações.
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ❌ REMOVER ESTE BLOCO DUPLICADO COMPLETAMENTE -->

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ===== Galeria com setas =====
            const images = @Html.Raw(JsonSerializer.Serialize(imagens));
            const mainImg = document.getElementById("mainImg");
            const thumbs = document.querySelectorAll(".thumb");
            const indexSpan = document.getElementById("imgIndex");

            const prevBtn = document.getElementById("imgPrev");
            const nextBtn = document.getElementById("imgNext");

            let idx = 0;

            function setActiveThumb() {
                thumbs.forEach(t => t.classList.remove("active"));
                const th = Array.from(thumbs).find(x => parseInt(x.dataset.idx) === idx);
                if (th) {
                    th.classList.add("active");
                    th.scrollIntoView({ block: "nearest", inline: "nearest" });
                }
            }

            function render() {
                if (!mainImg || !images || images.length === 0) return;

                mainImg.style.opacity = "0.75";
                mainImg.src = images[idx];
                setTimeout(() => mainImg.style.opacity = "1", 60);

                if (indexSpan) {
                    indexSpan.textContent = idx + 1;
                }

                if (prevBtn && nextBtn) {
                    const atStart = idx === 0;
                    const atEnd = idx === images.length - 1;

                    prevBtn.disabled = atStart;
                    nextBtn.disabled = atEnd;

                    prevBtn.classList.toggle("is-disabled", atStart);
                    nextBtn.classList.toggle("is-disabled", atEnd);
                }

                setActiveThumb();
            }

            thumbs.forEach(thumb => {
                thumb.addEventListener("click", function () {
                    const newIdx = parseInt(this.dataset.idx);
                    if (!Number.isNaN(newIdx)) {
                        idx = newIdx;
                        render();
                    }
                });
            });

            if (prevBtn) {
                prevBtn.addEventListener("click", function () {
                    if (idx > 0) { idx--; render(); }
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener("click", function () {
                    if (idx < images.length - 1) { idx++; render(); }
                });
            }

            const media = document.querySelector(".am-gallery-media");
            if (media) {
                media.setAttribute("tabindex", "0");
                media.addEventListener("keydown", function (e) {
                    if (e.key === "ArrowLeft" && idx > 0) { idx--; render(); }
                    if (e.key === "ArrowRight" && idx < images.length - 1) { idx++; render(); }
                });
            }

            render();

            // ===== ✅ Guardar HTML inicial do slot ANTES do primeiro AJAX =====
            const slot = document.getElementById("agendarSlot_@Model.id_anuncio");
            if (slot && !slot.dataset.closedHtml) {
                slot.dataset.closedHtml = slot.innerHTML; // guarda estado fechado
            }
        });

        // ===== ✅ Função global para fechar/resetar o slot de agendamento =====
        window.amCloseAgendar = function(idAnuncio) {
            const slot = document.getElementById("agendarSlot_" + idAnuncio);
            if (!slot) return;

            const html = slot.dataset.closedHtml;
            if (!html) return;

            // repõe o estado fechado (botão inicial)
            slot.innerHTML = html;
        };
    </script>
}