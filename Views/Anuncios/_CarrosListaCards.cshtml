@using System.Text.Json
@model IEnumerable<AutoMarket.Models.Market.Anuncio>


@if (!Model.Any())
{
    <div class="alert alert-light border">
        <i class="bi bi-info-circle"></i> Sem anúncios para os filtros atuais.
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var a in Model)
        {
            var imgs = (a.Anuncio_Imagem ?? new List<AutoMarket.Models.Market.Anuncio_Imagem>())
            .OrderByDescending(x => x.principal)
            .ThenBy(x => x.ordem ?? 9999)
            .Select(x => x.id_imagem_anuncioNavigation?.url)
            .Where(u => !string.IsNullOrWhiteSpace(u))
            .ToList();

            var img0 = imgs.FirstOrDefault();

            var v = a.id_veiculoNavigation;
            var sm = v?.id_sub_modeloNavigation;
            var md = sm?.id_modeloNavigation;
            var mk = md?.id_marcaNavigation;

            var tipoVendRaw = a.id_vendedorNavigation?.id_candidaturaNavigation?.tipo;
            var tipoVendedor = string.Equals(tipoVendRaw, "empresa", StringComparison.OrdinalIgnoreCase)
            ? "Empresa"
            : "Particular";
            <div class="card shadow-sm am-list-card">
                <a class="text-decoration-none text-dark am-card-link"
                   asp-action="Detalhes"
                   asp-route-id="@a.id_anuncio">

                    <div class="am-card-row">
                        <!-- IMAGEM -->
                        <div class="am-card-media"
                             @(imgs.Count > 0 ? Html.Raw($"data-images='{Html.Raw(JsonSerializer.Serialize(imgs))}'") : null)>

                            @if (!string.IsNullOrWhiteSpace(img0))
                            {
                                <img class="am-card-img" src="@img0" alt="@a.titulo" />
                            }
                            else
                            {
                                <div class="am-card-img-placeholder text-muted">
                                    <i class="bi bi-image" style="font-size:2.2rem;"></i>
                                </div>
                            }

                            @if (imgs.Count > 1)
                            {
                                <button type="button" class="am-img-nav am-prev" aria-label="Imagem anterior">&lt;</button>
                                <button type="button" class="am-img-nav am-next" aria-label="Imagem seguinte">&gt;</button>
                            }

                            @if (a.destaque)
                            {
                                <span class="badge bg-primary position-absolute top-0 end-0 m-2">Promovido</span>
                            }

                            @if (string.Equals(a.estado, "reservado", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">Reservado</span>
                            }
                        </div>

                        <!-- TEXTO -->
                        <div class="am-card-main">
                            <div class="fw-semibold fs-5 mb-1 text-truncate">@a.titulo</div>

                            <div class="text-muted small text-truncate mb-2">
                                @mk?.nome @md?.nome @(sm != null ? "• " + sm.nome : "")
                            </div>

                            <div class="d-flex flex-wrap gap-3 small mb-2">
                                @if (sm?.cilindrada > 0)
                                {
                                    <span>@sm.cilindrada cm³</span>
                                }
                                @if (sm?.potencia_hp > 0)
                                {
                                    <span><i class="bi bi-lightning-charge"></i> @sm.potencia_hp cv</span>
                                }
                                @if (v?.quilometragem != null)
                                {
                                    <span><i class="bi bi-speedometer2"></i> @v.quilometragem.Value.ToString("N0") km</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(sm?.combustivel))
                                {
                                    <span> @sm.combustivel</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(sm?.caixa))
                                {
                                    <span>@sm.caixa</span>
                                }
                                @if (v?.ano != null)
                                {
                                    <span><i class="bi bi-calendar3"></i> @v.ano</span>
                                }
                            </div>

                            <div class="small">
                                <div class="text-muted">
                                    <i class="bi bi-geo-alt"></i> @(string.IsNullOrWhiteSpace(a.localizacao) ? "—" : a.localizacao)
                                </div>
                                <div class="text-muted">
                                    <i class="bi bi-person-badge"></i> @tipoVendedor
                                </div>
                            </div>
                        </div>

                        <!-- PREÇO -->
                        <div class="am-card-price">
                            <div class="fs-4 fw-bold">
                                @(a.preco.HasValue ? $"{a.preco.Value:N0} €" : "—")
                            </div>
                        </div>
                    </div>
                </a>
            </div>

        }
    </div>
}
