@{
    ViewData["Title"] = "Os meus anúncios";

    var estado = (ViewBag.Estado as string) ?? "ativo";
    var q = (ViewBag.Q as string) ?? "";
    var sort = (ViewBag.Sort as string) ?? "recent";

    int cAtivo = ViewBag.CountAtivo ?? 0;
    int cInativo = ViewBag.CountInativo ?? 0;
    int cRasc = ViewBag.CountRascunho ?? 0;
    int cRes = ViewBag.CountReservado ?? 0;
    int cVend = ViewBag.CountVendido ?? 0;
    int cTodos = ViewBag.CountTodos ?? (cAtivo + cInativo + cRasc + cRes + cVend);
}

<style>
    .tabs2 {
        display: flex;
        gap: 26px;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 14px;
        padding-bottom: 6px;
    }

        .tabs2 a {
            padding: 12px 4px;
            text-decoration: none;
            color: #6b7280;
            font-weight: 650;
            border-bottom: 3px solid transparent;
        }

            .tabs2 a.active {
                color: #111827;
                border-bottom-color: #111827;
            }

    .toolbar2 {
        display: grid;
        grid-template-columns: 140px 1fr 260px 280px;
        gap: 12px;
        align-items: center;
        margin: 14px 0 10px 0;
    }
    @@media (max-width: 1100px) {
        .toolbar2 {
            grid-template-columns: 140px 1fr;
        }
    }

    .btnFilters {
        border: 1px solid #e5e7eb;
        background: #fff;
        border-radius: 10px;
        padding: 10px 14px;
        font-weight: 650;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .inputLike {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 10px 12px;
        background: #fff;
    }

    .mutedline {
        color: #6b7280;
        font-size: 14px;
        margin: 8px 0 12px 0;
    }
</style>

<h2 class="mb-2">@ViewData["Title"]</h2>

<!-- TABS -->
<div class="tabs2">
    <a class="@(estado == "ativo" ? "active" : "")"
       href="@Url.Action("Meus", "Anuncios", new { estado = "ativo", q = q, sort = sort })">
        Ativos (@cAtivo)
    </a>

    <a class="@(estado == "inativo" ? "active" : "")"
       href="@Url.Action("Meus", "Anuncios", new { estado = "inativo", q = q, sort = sort })">
        Pausados (@cInativo)
    </a>

    <a class="@(estado == "rascunho" ? "active" : "")"
       href="@Url.Action("Meus", "Anuncios", new { estado = "rascunho", q = q, sort = sort })">
        Rascunhos (@cRasc)
    </a>

    <a class="@(estado == "reservado" ? "active" : "")"
       href="@Url.Action("Meus", "Anuncios", new { estado = "reservado", q = q, sort = sort })">
        Reservados (@cRes)
    </a>

    <a class="@(estado == "vendido" ? "active" : "")"
       href="@Url.Action("Meus", "Anuncios", new { estado = "vendido", q = q, sort = sort })">
        Vendidos (@cVend)
    </a>

    <a class="@(estado == "todos" ? "active" : "")"
       href="@Url.Action("Meus", "Anuncios", new { estado = "todos", q = q, sort = sort })">
        Todos (@cTodos)
    </a>
</div>

<!-- TOOLBAR (parecida à print) -->
<form id="filterForm"
      method="get"
      asp-action="Meus"
      asp-controller="Anuncios"
      data-ajax="true"
      data-ajax-method="get"
      data-ajax-mode="replace"
      data-ajax-update="#listContainer"
      data-ajax-url="@Url.Action("_MeusLista","Anuncios")">

    <input type="hidden" name="estado" value="@estado" />

    <div class="toolbar2">
        <button type="button" class="btnFilters" onclick="alert('Ainda não implementado');">
            <span>⚙️</span> <span>Filtros</span>
        </button>

        <div class="inputLike">
            <input name="q"
                   value="@q"
                   class="form-control border-0 p-0"
                   placeholder="Pesquisar por título" />
        </div>

        <!-- categoria: só UI (se ainda não tens categorias reais, deixa assim) -->
        <select class="form-select inputLike" disabled>
            <option>Qualquer categoria</option>
        </select>

        <select name="sort" class="form-select inputLike">
            <option value="recent" selected="@(sort == "recent")">Data de publicação: Mais recente</option>
            <option value="oldest" selected="@(sort == "oldest")">Data de publicação: Mais antiga</option>
            <option value="price_asc" selected="@(sort == "price_asc")">Preço: mais baixo</option>
            <option value="price_desc" selected="@(sort == "price_desc")">Preço: mais alto</option>
        </select>
    </div>

    <div class="mutedline">
        A mostrar anúncios.
    </div>
</form>

<div id="listContainer">
    <div class="text-center text-muted py-4">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">A carregar...</span>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            let searchTimeout;

            $('select[name="sort"]').on('change', function () {
                $('#filterForm').trigger('submit');
            });

            $('input[name="q"]').on('input', function () {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(function () {
                    $('#filterForm').trigger('submit');
                }, 450);
            });

            // carrega logo ao abrir
            $('#filterForm').trigger('submit');
        });
    </script>
}
