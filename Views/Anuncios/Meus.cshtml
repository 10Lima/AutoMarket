@{
    ViewData["Title"] = "Os meus anúncios";

    var estado = (ViewBag.Estado as string) ?? "ativo";
    var q = (ViewBag.Q as string) ?? "";
    var sort = (ViewBag.Sort as string) ?? "recent";

    int cAtivo = ViewBag.CountAtivo ?? 0;
    int cInativo = ViewBag.CountInativo ?? 0;
    int cRasc = ViewBag.CountRascunho ?? 0;
    int cRes = ViewBag.CountReservado ?? 0;
    int cVend = ViewBag.CountVendido ?? 0;
    int cTodos = ViewBag.CountTodos ?? (cAtivo + cInativo + cRasc + cRes + cVend);
}

<style>
    .tabs2 {
        display: flex;
        gap: 26px;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 14px;
        padding-bottom: 6px;
        flex-wrap: wrap;
    }

        .tabs2 a {
            padding: 12px 4px;
            text-decoration: none;
            color: #6b7280;
            font-weight: 650;
            border-bottom: 3px solid transparent;
            cursor: pointer;
        }

            .tabs2 a.active {
                color: #111827;
                border-bottom-color: #111827;
            }

    .toolbar2 {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 12px;
        align-items: center;
        margin: 14px 0 10px 0;
    }

    @@media (max-width: 1100px) {
        .toolbar2 {
            grid-template-columns: 1fr;
        }
    }

    .inputLike {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 10px 12px;
        background: #fff;
    }

    .mutedline {
        color: #6b7280;
        font-size: 14px;
        margin: 8px 0 12px 0;
    }
</style>

<div class="container mt-3">

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="mb-0">@ViewData["Title"]</h2>

        <div class="d-flex gap-2">
            <a class="btn btn-dark" asp-controller="Anuncios" asp-action="Criar">
                <i class="bi bi-plus-lg"></i> Criar anúncio
            </a>

            <a class="btn btn-secondary" asp-controller="Anuncios" asp-action="Carros">
                Voltar aos carros
            </a>
        </div>

    </div>

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            @TempData["Msg"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }


    <!-- TABS (SEM reload: só AJAX) -->
    <div class="tabs2" id="meusTabs">
        <a href="@Url.Action("Meus", "Anuncios", new { estado = "ativo", q = q, sort = sort })"
           data-estado="ativo"
           class="@(estado == "ativo" ? "active" : "")">
            Ativos (@cAtivo)
        </a>

        <a href="@Url.Action("Meus", "Anuncios", new { estado = "inativo", q = q, sort = sort })"
           data-estado="inativo"
           class="@(estado == "inativo" ? "active" : "")">
            Pausados (@cInativo)
        </a>

        <a href="@Url.Action("Meus", "Anuncios", new { estado = "rascunho", q = q, sort = sort })"
           data-estado="rascunho"
           class="@(estado == "rascunho" ? "active" : "")">
            Rascunhos (@cRasc)
        </a>

        <a href="@Url.Action("Meus", "Anuncios", new { estado = "reservado", q = q, sort = sort })"
           data-estado="reservado"
           class="@(estado == "reservado" ? "active" : "")">
            Reservados (@cRes)
        </a>

        <a href="@Url.Action("Meus", "Anuncios", new { estado = "vendido", q = q, sort = sort })"
           data-estado="vendido"
           class="@(estado == "vendido" ? "active" : "")">
            Vendidos (@cVend)
        </a>

        <a href="@Url.Action("Meus", "Anuncios", new { estado = "todos", q = q, sort = sort })"
           data-estado="todos"
           class="@(estado == "todos" ? "active" : "")">
            Todos (@cTodos)
        </a>
    </div>

    <!-- TOOLBAR: só pesquisa + ordenação -->
    <form id="filterForm"
          method="get"
          asp-action="Meus"
          asp-controller="Anuncios"
          data-ajax="true"
          data-ajax-method="get"
          data-ajax-mode="replace"
          data-ajax-update="#listContainer"
          data-ajax-url="@Url.Action("_MeusLista","Anuncios")">

        <input type="hidden" name="estado" value="@estado" />

        <div class="toolbar2">
            <div class="inputLike">
                <input name="q"
                       value="@q"
                       class="form-control border-0 p-0"
                       placeholder="Pesquisar por título" />
            </div>

            <select name="sort" class="form-select inputLike">
                <option value="recent" selected="@(sort == "recent")">Data de publicação: Mais recente</option>
                <option value="oldest" selected="@(sort == "oldest")">Data de publicação: Mais antiga</option>
                <option value="price_asc" selected="@(sort == "price_asc")">Preço: mais baixo</option>
                <option value="price_desc" selected="@(sort == "price_desc")">Preço: mais alto</option>
            </select>
        </div>

        <div class="mutedline">
            A mostrar anúncios.
        </div>
    </form>

    <div id="listContainer">
        <div class="text-center text-muted py-4">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">A carregar...</span>
            </div>
        </div>
    </div>

</div>

@await Html.PartialAsync("_UserInfoModal")

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            function buildUrl(estado, q, sort) {
                const base = '@Url.Action("Meus", "Anuncios")';
                const p = new URLSearchParams();
                if (estado) p.set("estado", estado);
                if (q) p.set("q", q);
                if (sort) p.set("sort", sort);
                const qs = p.toString();
                return qs ? (base + "?" + qs) : base;
            }

            window.amMeusInit = function () {
                const $form = $('#filterForm');
                if (!$form.length) return;

                if ($form.data('bound') === 1) return;
                $form.data('bound', 1);

                const $estado = $form.find('input[name="estado"]');
                const $q = $form.find('input[name="q"]');
                const $sort = $form.find('select[name="sort"]');

                let searchTimeout;

                function submit() { $form.trigger('submit'); }

                $sort.on('change', submit);

                $q.on('input', function () {
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(submit, 450);
                });

                $('#meusTabs a[data-estado]').on('click', function (e) {
                    if (e.ctrlKey || e.metaKey || e.shiftKey || e.button === 1) return;

                    e.preventDefault();

                    const st = $(this).data('estado');
                    $estado.val(st);

                    $('#meusTabs a').removeClass('active');
                    $(this).addClass('active');

                    const url = buildUrl(st, $q.val(), $sort.val());
                    try { history.pushState(null, "", url); } catch { }

                    submit();
                });

                window.addEventListener('popstate', function () {
                    const params = new URLSearchParams(window.location.search);
                    const st = (params.get("estado") || "ativo");
                    const qq = (params.get("q") || "");
                    const so = (params.get("sort") || "recent");

                    $estado.val(st);
                    $q.val(qq);
                    $sort.val(so);

                    $('#meusTabs a').removeClass('active');
                    $('#meusTabs a[data-estado="' + st + '"]').addClass('active');

                    submit();
                });

                submit();
            };

            $(function () { window.amMeusInit(); });
        })();
    </script>
}
