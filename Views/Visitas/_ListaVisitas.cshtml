@using AutoMarket.Models.Market
@model List<Visita>

@{
    string estado = ViewBag.Estado ?? "pendente";
    string ordem = ViewBag.Ordem ?? "data_proxima";
}

@if (!Model.Any())
{
    <div class="alert alert-secondary">Sem visitas para os filtros selecionados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:90px;"></th>
                    <th>Detalhe</th>
                    <th style="width:180px;">Data agendada</th>
                    <th style="width:120px;">Estado</th>
                    <th style="width:240px;" class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    var anuncio = v.id_anuncioNavigation;
                    var img = anuncio?.Anuncio_Imagem?
                        .OrderByDescending(x => x.principal)
                        .ThenBy(x => x.ordem ?? 9999)
                        .FirstOrDefault()
                        ?.id_imagem_anuncioNavigation?.url;

                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(img))
                            {
                                <img src="@img" class="rounded" style="width:80px;height:55px;object-fit:cover;" alt="Imagem" />
                            }
                            else
                            {
                                <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                     style="width:80px;height:55px;">
                                    <i class="bi bi-image text-muted"></i>
                                </div>
                            }
                        </td>

                        <td>
                            <div class="fw-semibold">
                                <a asp-controller="Anuncios" asp-action="Detalhes" asp-route-id="@v.id_anuncio">
                                    @(anuncio?.titulo ?? $"Anúncio #{v.id_anuncio}")
                                </a>
                            </div>
                            <div class="text-muted small">
                                Visita #@v.id_visita · Comprador #@v.id_utilizador
                            </div>
                        </td>

                        <td>@v.data_visita.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>

                        <td><span class="badge bg-secondary">@v.estado</span></td>

                        <td class="text-end">
                            @if (v.estado == "pendente")
                            {
                                <form asp-action="Aceitar" method="post"
                                      data-ajax="true"
                                      data-ajax-method="POST"
                                      data-ajax-update="#listaVisitas"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@v.id_visita" />
                                    <input type="hidden" name="estado" value="@estado" />
                                    <input type="hidden" name="ordem" value="@ordem" />
                                    <button class="btn btn-success btn-sm">Aceitar</button>
                                </form>

                                <form asp-action="Rejeitar" method="post"
                                      data-ajax="true"
                                      data-ajax-method="POST"
                                      data-ajax-update="#listaVisitas"
                                      class="d-inline ms-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@v.id_visita" />
                                    <input type="hidden" name="estado" value="@estado" />
                                    <input type="hidden" name="ordem" value="@ordem" />
                                    <button class="btn btn-outline-danger btn-sm">Rejeitar</button>
                                </form>
                            }
                            else if (v.estado == "agendada")
                            {
                                <form asp-action="CancelarVendedor" method="post"
                                      data-ajax="true"
                                      data-ajax-method="POST"
                                      data-ajax-update="#listaVisitas"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@v.id_visita" />
                                    <input type="hidden" name="estado" value="@estado" />
                                    <input type="hidden" name="ordem" value="@ordem" />
                                    <button class="btn btn-outline-danger btn-sm">Cancelar</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}