@{
    var data = ViewBag.DataAgendada as string ?? "";
}

<div class="alert alert-success border mb-0">
    <i class="bi bi-check-circle"></i>
    Pedido submetido (estado: <strong>pendente</strong>).
    @if (!string.IsNullOrWhiteSpace(data))
    {
        <div class="mt-1"><strong>Data proposta:</strong> @data</div>
    }
</div>