@{
    int idAnuncio = (int)(ViewBag.IdAnuncio ?? 0);
    string dataAgendada = (string)(ViewBag.DataAgendada ?? "");
}

<div class="alert alert-success border mb-0 d-flex justify-content-between align-items-start gap-3">
    <div>
        <h6 class="mb-1">
            <i class="bi bi-check-circle-fill"></i> Pedido submetido
        </h6>
        <p class="mb-0">
            O teu pedido de visita @(!string.IsNullOrWhiteSpace(dataAgendada) ? $"para {dataAgendada}" : "") 
            foi submetido com estado <strong>pendente</strong>.<br />
            O vendedor irá aceitar ou rejeitar em breve.
        </p>
    </div>

    <button type="button"
            class="am-close"
            onclick="amCloseAgendar(@idAnuncio)"
            aria-label="Fechar">
        &times;
    </button>
</div>
