@{
    int idAnuncio = (int)(ViewBag.IdAnuncio ?? 0);
    long idVisita = (long)(ViewBag.IdVisita ?? 0L);
    string dataAgendada = (string)(ViewBag.DataAgendada ?? "");
}

<div class="alert alert-success border mb-0">
    <h6 class="mb-1">
        <i class="bi bi-check-circle-fill"></i> Pedido submetido
    </h6>

    <div class="small text-muted mb-3">
        Estado: <strong>pendente</strong>
        @if (!string.IsNullOrWhiteSpace(dataAgendada))
        {
            <span> · Data proposta: <strong>@dataAgendada</strong></span>
        }
    </div>

    <form asp-controller="Visitas" asp-action="CancelarDetalhe" method="post"
          data-ajax="true"
          data-ajax-method="POST"
          data-ajax-update="#agendarSlot_@idAnuncio"
          data-ajax-mode="replace"
          onsubmit="return confirm('Cancelar esta visita?');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="idVisita" value="@idVisita" />
        <input type="hidden" name="idAnuncio" value="@idAnuncio" />

        <button class="btn-am btn-am-outline w-100" type="submit">
            <i class="bi bi-x-circle"></i>
            Cancelar Visita a @dataAgendada
        </button>
    </form>
</div>
