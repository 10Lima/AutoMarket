@using AutoMarket.Models.Market
@model IEnumerable<Visita>

@{
    var lista = Model ?? Enumerable.Empty<Visita>();

    string estado = ViewBag.Estado ?? "todos";
    string ordem = ViewBag.Ordem ?? "recent";

    string Badge(string? e) => (e ?? "").ToLowerInvariant() switch
    {
        "pendente" => "bg-warning text-dark",
        "agendada" => "bg-success",
        "rejeitada" => "bg-danger",
        "cancelada" => "bg-secondary",
        "realizada" => "bg-info text-dark",
        _ => "bg-secondary"
    };

    string Label(string? e) => (e ?? "").ToLowerInvariant() switch
    {
        "pendente" => "Pendente",
        "agendada" => "Agendada",
        "rejeitada" => "Rejeitada",
        "cancelada" => "Cancelada",
        "realizada" => "Realizada",
        _ => e ?? "—"
    };

    string? PrimeiraImagem(Visita v)
        => v.id_anuncioNavigation?.Anuncio_Imagem?
            .OrderByDescending(x => x.principal)
            .ThenBy(x => x.ordem ?? 9999)
            .Select(x => x.id_imagem_anuncioNavigation?.url)
            .FirstOrDefault(u => !string.IsNullOrWhiteSpace(u));
}

@if (!lista.Any())
{
    <div class="alert alert-light border text-center py-4 mb-0">
        <i class="bi bi-inbox" style="font-size: 2.5rem; color: #ccc;"></i>
        <p class="mt-2 mb-0 text-muted">Não tens visitas com estes filtros.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Anúncio</th>
                    <th class="text-center" style="width:170px;">Estado</th>
                    <th class="text-center" style="width:220px;">Data visita</th>
                    <th class="text-end" style="width:260px;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in lista)
                {
                    var a = v.id_anuncioNavigation;
                    var img = PrimeiraImagem(v);
                    var dataLocal = v.data_visita.ToLocalTime();

                    <tr>
                        <td style="min-width:360px;">
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(img))
                                {
                                    <img src="@img" alt="Imagem do anúncio" class="am-ops-img" />
                                }
                                else
                                {
                                    <div class="am-ops-img-placeholder">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }

                                <div>
                                    <div class="fw-semibold">
                                        <a asp-controller="Anuncios" asp-action="Detalhes" asp-route-id="@v.id_anuncio"
                                           class="text-decoration-none">
                                            @(a?.titulo ?? "—")
                                        </a>
                                    </div>
                                    <div class="text-muted small">
                                        @(a?.preco.HasValue == true ? $"{a.preco.Value:N0} €" : "—")
                                    </div>
                                </div>
                            </div>
                        </td>

                        <td class="text-center">
                            <span class="badge @Badge(v.estado)"
                                  style="min-width:130px;height:34px;display:inline-flex;align-items:center;justify-content:center;border-radius:10px;font-weight:650;">
                                @Label(v.estado)
                            </span>
                        </td>

                        <td class="text-center">
                            <div class="small">@dataLocal.ToString("dd/MM/yyyy")</div>
                            <div class="small text-muted">@dataLocal.ToString("HH:mm")</div>
                        </td>

                        <td class="text-end">
                            <div class="d-inline-flex gap-2 am-ops-actions">
                                <a asp-controller="Anuncios" asp-action="Detalhes" asp-route-id="@v.id_anuncio"
                                   class="btn btn-sm btn-outline-dark">
                                    <i class="bi bi-eye"></i> Ver
                                </a>

                                @if (string.Equals(v.estado, "pendente", StringComparison.OrdinalIgnoreCase)
                                                        || string.Equals(v.estado, "agendada", StringComparison.OrdinalIgnoreCase))
                                {
                                    <form asp-controller="Visitas" asp-action="CancelarComprador" method="post"
                                          data-ajax="true"
                                          data-ajax-method="POST"
                                          data-ajax-update="#visitasListaArea"
                                          data-ajax-mode="replace"
                                          class="d-inline"
                                          onsubmit="return confirm('Cancelar esta visita?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@v.id_visita" />
                                        <input type="hidden" name="estado" value="@estado" />
                                        <input type="hidden" name="ordem" value="@ordem" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">
                                            <i class="bi bi-x-circle"></i> Cancelar
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
