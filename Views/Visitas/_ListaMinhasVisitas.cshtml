@using AutoMarket.Models.Market
@model List<Visita>

@{
    string estado = ViewBag.Estado ?? "todos";
    string ordem = ViewBag.Ordem ?? "data_proxima";
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-secondary mb-0">Sem visitas.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:90px;"></th>
                    <th>Detalhe</th>
                    <th style="width:180px;">Data</th>
                    <th style="width:120px;">Estado</th>
                    <th style="width:170px;" class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var v in Model)
            {
                var a = v.id_anuncioNavigation;
                var img = a?.Anuncio_Imagem?
                    .OrderByDescending(x => x.principal)
                    .ThenBy(x => x.ordem ?? 9999)
                    .Select(x => x.id_imagem_anuncioNavigation?.url)
                    .FirstOrDefault(u => !string.IsNullOrWhiteSpace(u));

                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(img))
                        {
                            <img src="@img" class="rounded" style="width:80px;height:55px;object-fit:cover;" alt="Imagem" />
                        }
                        else
                        {
                            <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                 style="width:80px;height:55px;">
                                <i class="bi bi-image text-muted"></i>
                            </div>
                        }
                    </td>

                    <td>
                        <div class="fw-semibold">
                            <a asp-controller="Anuncios" asp-action="Detalhes" asp-route-id="@v.id_anuncio">
                                @(a?.titulo ?? $"Anúncio #{v.id_anuncio}")
                            </a>
                        </div>
                        <div class="text-muted small">Visita #@v.id_visita</div>
                    </td>

                    <td>@v.data_visita.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>

                    <td><span class="badge bg-secondary">@v.estado</span></td>

                    <td class="text-end">
                        @if (v.estado != "realizada" && v.estado != "cancelada")
                        {
                            <form asp-controller="Visitas" asp-action="CancelarComprador" method="post"
                                  data-ajax="true"
                                  data-ajax-method="POST"
                                  data-ajax-update="#minhasVisitasLista"
                                  data-ajax-mode="replace"
                                  class="d-inline"
                                  onsubmit="return confirm('Cancelar esta visita?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@v.id_visita" />
                                <input type="hidden" name="estado" value="@estado" />
                                <input type="hidden" name="ordem" value="@ordem" />
                                <button class="btn btn-outline-danger btn-sm">Cancelar</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">—</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}