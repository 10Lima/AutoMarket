@model IEnumerable<AutoMarket.Models.Market.Marca>

@{
    ViewData["Title"] = "Marcas";
    var sort = (ViewBag.Sort as string) ?? "az";
}

<div class="register-page">
    <div class="register-card">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h1 class="page-title mb-1">Marcas</h1>
                <p class="page-subtitle mb-0">
                    Explora todas as marcas disponíveis no AutoMarket.
                </p>
            </div>

            <div class="btn-group">
                <a href="@Url.Action("_Lista", "Marcas", new { sort = "az" })"
                   class="btn js-sort @(sort == "az" ? "btn-dark-custom" : "btn-outline-dark-custom")"
                   data-sort="az"
                   data-ajax="true"
                   data-ajax-mode="replace"
                   data-ajax-update="#marcasList"
                   data-ajax-success="onSortSuccess">
                    A-Z
                </a>

                <a href="@Url.Action("_Lista", "Marcas", new { sort = "top" })"
                   class="btn js-sort @(sort == "top" ? "btn-dark-custom" : "btn-outline-dark-custom")"
                   data-sort="top"
                   data-ajax="true"
                   data-ajax-mode="replace"
                   data-ajax-update="#marcasList"
                   data-ajax-success="onSortSuccess">
                    Top Marcas
                </a>
            </div>
        </div>

        <!-- LISTA (AJAX) -->
        <div id="marcasList" data-current-sort="@sort">
            <partial name="_MarcasLista" model="Model" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.min.js"></script>

    <script>
        function setSortButtons(sort) {
            $("#marcasList").attr("data-current-sort", sort);

            $(".js-sort").each(function () {
                var btnSort = $(this).data("sort");
                if (btnSort === sort) {
                    $(this).removeClass("btn-outline-dark-custom").addClass("btn-dark-custom");
                } else {
                    $(this).removeClass("btn-dark-custom").addClass("btn-outline-dark-custom");
                }
            });
        }

        function onSortSuccess() {
            var sort = $(this).data("sort");
            setSortButtons(sort);
        }

        function onFavSuccess(data) {
            if (!data || !data.idMarca) return;

            var icon = document.getElementById("favIcon-" + data.idMarca);
            if (!icon) return;

            if (data.favorito === true) {
                icon.classList.remove("bi-heart", "text-muted");
                icon.classList.add("bi-heart-fill", "text-danger");
            } else {
                icon.classList.remove("bi-heart-fill", "text-danger");
                icon.classList.add("bi-heart", "text-muted");
            }
        }

        function onFavFail(xhr) {
            if (xhr.status === 401 || xhr.status === 403) {
                var returnUrl = window.location.pathname + window.location.search;
                window.location.href = "/Identity/Account/Login?returnUrl=" + encodeURIComponent(returnUrl);
            }
        }
    </script>
}

<style>
    .register-page {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        background: #f5f5f5;
        min-height: calc(100vh - 70px);
        padding: 32px 20px;
    }

    .register-card {
        background: #fff;
        border-radius: 16px;
        padding: 40px;
        max-width: 1400px;
        margin: 0 auto;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .page-title {
        font-weight: 750;
        letter-spacing: -.4px;
        color: #111;
    }

    .page-subtitle {
        color: #555;
    }

    .btn-dark-custom {
        background: #000;
        color: #fff;
        border-radius: 12px;
        border: none;
        font-weight: 600;
    }

    .btn-outline-dark-custom {
        border: 2px solid #000;
        color: #000;
        border-radius: 12px;
        font-weight: 600;
    }
</style>
