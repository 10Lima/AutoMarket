@model AutoMarket.Models.Market.Encomenda

@{
    ViewData["Title"] = "Checkout";
}

<div class="container mt-3">
    <h2>Checkout</h2>

    <div class="card mb-3">
        <div class="card-body">
            <div><strong>Anúncio:</strong> @(Model.id_anuncioNavigation?.titulo ?? $"#{Model.id_anuncio}")</div>
            <div><strong>Método:</strong> Cartão</div>
        </div>
    </div>

    <form asp-controller="Encomendas" asp-action="Adicionar" method="post" class="d-grid">
        @Html.AntiForgeryToken()
        <input type="hidden" name="idAnuncio" value="@Model.id_anuncio" />
        <button class="btn btn-success btn-lg" type="submit">
            <i class="bi bi-cart-check"></i> Comprar
        </button>
    </form>
</div>