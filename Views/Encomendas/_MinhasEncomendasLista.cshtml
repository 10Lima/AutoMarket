@model IEnumerable<AutoMarket.Models.Market.Encomenda>

@{
    var lista = Model ?? Enumerable.Empty<AutoMarket.Models.Market.Encomenda>();

    string Badge(string? e) => (e ?? "").ToLowerInvariant() switch
    {
        "pendente" => "bg-warning text-dark",
        "pago" => "bg-success",
        "cancelado" => "bg-secondary",
        _ => "bg-secondary"
    };

    string Label(string? e) => (e ?? "").ToLowerInvariant() switch
    {
        "pendente" => "Pendente",
        "pago" => "Pago",
        "cancelado" => "Cancelado",
        _ => e ?? "—"
    };

    string? PrimeiraImagem(AutoMarket.Models.Market.Encomenda e)
        => e.id_anuncioNavigation?.Anuncio_Imagem?
            .OrderByDescending(x => x.principal)
            .ThenBy(x => x.ordem ?? 9999)
            .Select(x => x.id_imagem_anuncioNavigation?.url)
            .FirstOrDefault(u => !string.IsNullOrWhiteSpace(u));
}

@if (!lista.Any())
{
    <div class="alert alert-light border text-center py-4 mb-0">
        <i class="bi bi-inbox" style="font-size: 2.5rem; color: #ccc;"></i>
        <p class="mt-2 mb-0 text-muted">Não tens encomendas com estes filtros.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Anúncio</th>
                    <th class="text-center" style="width:170px;">Estado</th>
                    <th class="text-center" style="width:220px;">Data</th>
                    <th class="text-center" style="width:220px;">Referência</th>
                    <th class="text-end" style="width:360px;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in lista)
                {
                    var a = e.id_anuncioNavigation;
                    var img = PrimeiraImagem(e);
                    var data = e.data_encomenda.ToLocalTime();

                    <tr>
                        <td style="min-width:360px;">
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(img))
                                {
                                    <img src="@img" alt="Imagem do anúncio" class="am-ops-img" />
                                }
                                else
                                {
                                    <div class="am-ops-img-placeholder">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }

                                <div>
                                    <div class="fw-semibold">
                                        <a asp-controller="Anuncios" asp-action="Detalhes" asp-route-id="@e.id_anuncio"
                                           class="text-decoration-none">
                                            @(a?.titulo ?? "—")
                                        </a>
                                    </div>
                                    <div class="text-muted small">
                                        @(a?.preco.HasValue == true ? $"{a.preco.Value:N0} €" : "—")
                                    </div>
                                </div>
                            </div>
                        </td>

                        <td class="text-center">
                            <span class="badge @Badge(e.estado)"
                                  style="min-width:130px;height:34px;display:inline-flex;align-items:center;justify-content:center;border-radius:10px;font-weight:650;">
                                @Label(e.estado)
                            </span>
                        </td>

                        <td class="text-center">
                            <div class="small">@data.ToString("dd/MM/yyyy")</div>
                            <div class="small text-muted">@data.ToString("HH:mm")</div>
                        </td>

                        <td class="text-center">
                            @if (!string.IsNullOrWhiteSpace(e.ref_pagamento))
                            {
                                <code class="small">@e.ref_pagamento</code>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>

                        <td class="text-end">
                            <div class="d-inline-flex gap-2 am-ops-actions">
                                <a asp-controller="Anuncios" asp-action="Detalhes" asp-route-id="@e.id_anuncio"
                                   class="btn btn-sm btn-outline-dark">
                                    <i class="bi bi-eye"></i> Ver
                                </a>

                                @if (string.Equals(e.estado, "pendente", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a asp-controller="Encomendas" asp-action="Checkout" asp-route-id="@e.id_encomenda"
                                       class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-credit-card"></i> Checkout
                                    </a>

                                    <form asp-controller="Encomendas" asp-action="Cancelar" method="post"
                                          data-ajax="true"
                                          data-ajax-method="POST"
                                          data-ajax-update="#encomendasListaArea"
                                          data-ajax-mode="replace"
                                          class="d-inline"
                                          onsubmit="return confirm('Queres mesmo cancelar esta encomenda?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@e.id_encomenda" />
                                        <input type="hidden" name="returnTo" value="MinhasOperacoes" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-circle"></i> Cancelar
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
