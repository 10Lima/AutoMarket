@using Microsoft.EntityFrameworkCore
@inject AutoMarket.Services.CurrentUserService CurrentUser
@inject AutoMarket.Data.MarketplaceDbContext MarketDb
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoMarket</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="~/lib/jqueryui/themes/base/jquery-ui.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/AutoMarket.styles.css" asp-append-version="true" />

    <!-- ✅ Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
</head>
<body>
    @{
        // ✅ Detectar se o utilizador autenticado é admin (Razor suporta await)
        var isAdmin = User?.Identity?.IsAuthenticated == true
            ? await CurrentUser.IsAdminAsync(User)
            : false;

        // ✅ Detectar se estamos na Home/Index
        var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "");
        var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? "");
        var isHomeIndex = controller == "Home" && action == "Index";
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark am-navbar am-navbar-main border-bottom box-shadow @(isHomeIndex ? "" : "mb-3")">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AutoMarket</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Anuncios" asp-action="Carros">Carros</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Marcas" asp-action="Index">As Nossas Marcas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Notificacoes" asp-action="Index">Notificações</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="SobreNos">Sobre Nós</a>
                        </li>

                        <partial name="_AdminMenuPartial" />
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @* ✅ Só mostra "+ Vender" se NÃO for admin *@
                        @if (!isAdmin)
                        {
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link fw-bold text-success" asp-controller="Vender" asp-action="Comecar">
                                        <i class="bi bi-plus-circle me-1"></i>Vender
                                    </a>
                                </li>
                            </ul>
                        }

                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    @*
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - AutoMarket - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jqueryui/jquery-ui.js"></script>
    <script src="~/lib/jquery-ajax/jquery.unobtrusive-ajax.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- ✅ Select2 JS (DEPOIS do jQuery) -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- ✅ SortableJS (para drag & drop de reordenar) -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

    <!-- ✅ Script do modal de admin -->
    <script src="~/js/admin-motivo-modal.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
