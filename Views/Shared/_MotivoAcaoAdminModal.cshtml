@* Views/Shared/_MotivoAcaoAdminModal.cshtml (SÓ HTML) *@

<div class="modal fade" id="motivoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="motivoForm" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="motivoTitulo">Ação de administração</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="motivoIdUtilizador" name="idUtilizador" value="" />

                    <div class="mb-3">
                        <label class="form-label" for="motivoTexto">
                            Motivo <span class="text-danger" id="motivoObrigatorio">*</span>
                        </label>

                        <textarea class="form-control"
                                  id="motivoTexto"
                                  name="motivo"
                                  rows="4"
                                  maxlength="400"></textarea>

                        <div class="form-text">
                            <span id="motivoCounter">0</span>/400 caracteres
                        </div>
                    </div>

                    <div id="motivosSugestoesArea">
                        <div class="form-text mb-2">
                            <i class="bi bi-lightbulb"></i> Sugestões rápidas
                        </div>
                        <div id="motivosSugestoes" class="d-flex flex-wrap gap-2"></div>
                    </div>

                    <div id="motivoErro" class="alert alert-danger mt-3" style="display:none;"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="motivoSubmit">Confirmar</button>
                </div>
            </form>
        </div>
    </div>
</div>
