@model List<AutoMarket.Models.Market.Utilizador>

@{
    ViewData["Title"] = "Utilizadores";
    var filtroAtual = (ViewData["FiltroAtual"] as string) ?? "";
    var adminFiltroAtual = (ViewData["AdminFiltroAtual"] as string) ?? "todos";
}

<div class="admin-page">
    <div class="admin-card">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <h1 class="page-title mb-0">@ViewData["Title"]</h1>
        </div>

        <!-- Filtros -->
        <div class="card card-soft mb-3">
            <div class="card-body">
                <form id="filtroForm"
                      method="get"
                      asp-controller="AdminGestaoUtilizadores"
                      asp-action="Lista"
                      data-ajax="true"
                      data-ajax-method="get"
                      data-ajax-mode="replace"
                      data-ajax-update="#utilizadoresArea"
                      class="row g-3 align-items-end">

                    <div class="col-md-4">
                        <label class="form-label" for="filtro">Pesquisar</label>
                        <input class="form-control form-control-soft"
                               id="filtro"
                               name="filtro"
                               value="@filtroAtual"
                               placeholder="ID / username / email" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label" for="adminFiltro">Tipo</label>
                        <select class="form-select form-control-soft admin-select"
                                id="adminFiltro"
                                name="adminFiltro">
                            <option value="todos" selected="@(adminFiltroAtual == "todos")">Todos</option>
                            <option value="admins" selected="@(adminFiltroAtual == "admins")">Só admins</option>
                            <option value="nao_admins" selected="@(adminFiltroAtual == "nao_admins")">Só não admins</option>
                        </select>
                    </div>

                </form>
            </div>
        </div>

        <!-- Área AJAX -->
        <div id="utilizadoresArea">
            <partial name="_UtilizadoresTable" model="Model" />
        </div>

    </div>
</div>

<partial name="_MotivoAcaoAdminModal" />

@section Scripts {
    <script>
        (function () {
            const formFiltro = document.getElementById('filtroForm');
            const filtro = document.getElementById('filtro');
            const adminFiltro = document.getElementById('adminFiltro');
            const modalForm = document.getElementById('motivoForm');

            if (!formFiltro) return;

            function debounce(fn, delay) {
                let t = null;
                return function () {
                    clearTimeout(t);
                    t = setTimeout(fn, delay);
                };
            }

            const submitNow = function () {
                if (formFiltro.requestSubmit) formFiltro.requestSubmit();
                else $(formFiltro).submit();
            };

            const submitDebounced = debounce(submitNow, 350);

            if (adminFiltro) adminFiltro.addEventListener('change', submitNow);
            if (filtro) filtro.addEventListener('input', submitDebounced);

            if (modalForm) {
                modalForm.addEventListener('submit', function () {
                    let hidden = modalForm.querySelector('input[name="filtroAtual"]');
                    if (!hidden) {
                        hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = 'filtroAtual';
                        modalForm.appendChild(hidden);
                    }
                    hidden.value = filtro ? (filtro.value || '') : '';
                });
            }

            document.addEventListener('click', function (e) {
                const btnB = e.target.closest('.btn-bloquear');
                if (btnB) {
                    abrirMotivoAdmin('bloquear', '@Url.Action("Bloquear", "AdminGestaoUtilizadores")', btnB.dataset.id, submitNow);
                    return;
                }

                const btnD = e.target.closest('.btn-desbloquear');
                if (btnD) {
                    abrirMotivoAdmin('desbloquear', '@Url.Action("Desbloquear", "AdminGestaoUtilizadores")', btnD.dataset.id, submitNow);
                    return;
                }

                const btnR = e.target.closest('.btn-removeradmin');
                if (btnR) {
                    abrirMotivoAdmin('remover_admin', '@Url.Action("RemoverAdmin", "AdminGestaoUtilizadores")', btnR.dataset.id, submitNow);
                    return;
                }

                const btnRec = e.target.closest('.btn-recuperaradmin');
                if (btnRec) {
                    abrirMotivoAdmin('recuperar_admin', '@Url.Action("RecuperarAdmin", "AdminGestaoUtilizadores")', btnRec.dataset.id, submitNow);
                    return;
                }
            });
        })();
    </script>
}

<style>
    .admin-page {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        background-color: #f5f5f5;
        min-height: calc(100vh - 70px);
        padding: 32px 20px;
    }

    .admin-card {
        background: #fff;
        border-radius: 14px;
        padding: 40px;
        max-width: 1200px;
        margin: 0 auto;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .page-title {
        font-weight: 800;
        color: #111;
    }

    .card-soft {
        border-radius: 14px;
        border: 1px solid rgba(0,0,0,0.06);
        box-shadow: 0 8px 22px rgba(0,0,0,0.05);
    }

    .form-control-soft {
        border-radius: 12px;
        padding: 10px 12px;
        border: 1px solid rgba(0,0,0,0.1);
    }

    select.admin-select {
        padding-right: 2.4rem;
        background-position: right .9rem center;
        background-size: 16px 12px;
    }

    @@media (max-width: 576px) {
        .admin-card {
            padding: 22px;
        }
    }
</style>
