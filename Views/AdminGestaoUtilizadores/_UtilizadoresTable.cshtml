@model List<AutoMarket.Models.Market.Utilizador>

@{
    var usernames = ViewData["Usernames"] as Dictionary<int, string> ?? new();
    var emails = ViewData["Emails"] as Dictionary<int, string> ?? new();
    var adminsAtuais = ViewData["AdminsAtuais"] as HashSet<int> ?? new();
    var estados = ViewData["Estados"] as Dictionary<int, string> ?? new();
    var podeRecuperar = ViewData["PodeRecuperarAdmin"] as HashSet<int> ?? new();
}

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info alert-soft">Sem resultados.</div>
}
else
{
    <div class="table-responsive table-soft-wrap">
        <table class="table table-hover align-middle table-soft mb-0">
            <thead>
                <tr>
                    <th class="th-soft text-center">ID</th>
                    <th class="th-soft text-center">Username</th>
                    <th class="th-soft text-center">Email</th>
                    <th class="th-soft text-center">Nome</th>
                    <th class="th-soft text-center">Estado</th>
                    <th class="th-soft text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    usernames.TryGetValue(u.id_utilizador, out var uname);
                    emails.TryGetValue(u.id_utilizador, out var em);

                    var id = u.id_utilizador;
                    var isAdminAtual = adminsAtuais.Contains(id);
                    estados.TryGetValue(id, out var estado);
                    estado = (estado ?? "ativo").ToLowerInvariant();
                    var foiRemovidoAdmin = podeRecuperar.Contains(id);

                    <tr>
                        <td class="td-soft text-center">@id</td>
                        <td class="td-soft">@((string.IsNullOrWhiteSpace(uname)) ? $"#{id}" : uname)</td>
                        <td class="td-soft">@em</td>
                        <td class="td-soft">@u.nome</td>

                        <!-- ESTADO -->
                        <td class="td-soft text-center">
                            <div class="estado-badges">
                                @if (estado == "bloqueado")
                                {
                                    <span class="badge badge-state badge-bloqueado">bloqueado</span>
                                }
                                else
                                {
                                    <span class="badge badge-state badge-ativo">ativo</span>
                                }

                                @if (isAdminAtual)
                                {
                                    <span class="badge badge-state badge-admin">admin</span>
                                }
                            </div>
                        </td>

                        <!-- AÇÕES -->
                        <td class="td-soft text-center">
                            @if (isAdminAtual)
                            {
                                <button class="btn btn-sm btn-warning btn-removeradmin" data-id="@id">
                                    Remover admin
                                </button>
                            }
                            else
                            {
                                if (estado == "bloqueado" && foiRemovidoAdmin)
                                {
                                    <button class="btn btn-sm btn-success btn-recuperaradmin" data-id="@id">
                                        Recuperar admin
                                    </button>
                                }
                                else if (estado == "ativo")
                                {
                                    <button class="btn btn-sm btn-danger btn-bloquear" data-id="@id">
                                        Bloquear
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-success btn-desbloquear" data-id="@id">
                                        Desbloquear
                                    </button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<style>
    /* ---------- ALERT ---------- */
    .alert-soft {
        border-radius: 14px;
        border: 1px solid rgba(0,0,0,0.06);
    }

    /* ---------- TABLE WRAPPER ---------- */
    .table-soft-wrap {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.06);
        box-shadow: 0 8px 22px rgba(0,0,0,0.05);
    }

    /* ---------- HEADERS & CELLS ---------- */
    .th-soft {
        padding: 16px 26px;
        font-weight: 700;
        color: #111;
    }

    .td-soft {
        padding: 16px 26px;
        vertical-align: middle;
    }

    /* ---------- ESTADO: CENTRADO + BADGES IGUAIS AO MAIOR TEXTO ---------- */
    .estado-badges {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .badge-state {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        /* ✅ largura igual para todas (cabe "bloqueado") */
        min-width: 11ch;
        padding: 6px 12px;
        border-radius: 999px;
        font-weight: 600;
        color: #fff;
        white-space: nowrap;
    }

    .badge-ativo {
        background: #16a34a;
    }

    .badge-bloqueado {
        background: #dc2626;
    }

    .badge-admin {
        background: #111;
    }

    /* ---------- AÇÕES: BOTÕES IGUAIS ---------- */
    .table-soft td:last-child .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 18ch;
        height: 32px;
        padding: 0 12px;
        white-space: nowrap;
        box-sizing: border-box;
    }

    /* ---------- CENTRAR TEXTO DAS COLUNAS ---------- */

    /* Username */
    .table-soft td:nth-child(2),
    .table-soft th:nth-child(2),

    /* Email */
    .table-soft td:nth-child(3),
    .table-soft th:nth-child(3),

    /* Nome */
    .table-soft td:nth-child(4),
    .table-soft th:nth-child(4) {
        text-align: center;
    }
</style>
