@using AutoMarket.Services
@inject CurrentUserService CurrentUser

@{
    ViewData["Title"] = "AutoMarket";
    var isAdmin = User?.Identity?.IsAuthenticated == true
        ? await CurrentUser.IsAdminAsync(User)
        : false;
}

<div class="am-home-splash">
    <div class="am-home-content text-center">
        <h1 class="am-home-title">AutoMarket</h1>

        @if (isAdmin)
        {
            <div class="am-home-admin">(Modo Admin)</div>
        }

        <div class="am-home-by">by</div>

        <ul class="am-home-names list-unstyled mb-0">
            <li>Diogo Borges <span class="am-home-code">al80884</span></li>
            <li>Afonso Silva <span class="am-home-code">al82140</span></li>
            <li>Daniel Lima <span class="am-home-code">al82710</span></li>
            <li>Tiago Mendes <span class="am-home-code">80893</span></li>
        </ul>

        <a class="btn am-home-btn" asp-controller="Anuncios" asp-action="Carros">
            Carros
        </a>
    </div>
</div>
