@{
    ViewData["Title"] = "AutoMarket";
}

<style>
    :root {
        --bg: #f5f5f5;
        --panel: #ffffff;
        --text: #111111;
        --muted: #5e5e5e;
        --line: rgba(0,0,0,.10);
        --soft: rgba(0,0,0,.05);
        --shadow: 0 18px 70px rgba(0,0,0,.10);
        --shadow2: 0 10px 28px rgba(0,0,0,.06);
        --radius: 22px;
    }

    /* full page */
    .home-wrap {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 46px 16px;
        background: radial-gradient(1100px 520px at 18% 10%, rgba(0,0,0,.05), transparent 60%), radial-gradient(900px 480px at 82% 38%, rgba(0,0,0,.04), transparent 60%), linear-gradient(180deg, #fafafa, var(--bg));
        color: var(--text);
    }

    .home-card {
        width: min(1120px, 100%);
        border: 1px solid var(--line);
        background: linear-gradient(180deg, rgba(255,255,255,1), rgba(255,255,255,.98));
        border-radius: var(--radius);
        padding: 34px;
        box-shadow: var(--shadow);
        position: relative;
        overflow: hidden;
    }

        .home-card:before {
            content: "";
            position: absolute;
            inset: -2px;
            background: radial-gradient(680px 280px at 18% 0%, rgba(0,0,0,.06), transparent 55%), radial-gradient(540px 260px at 90% 20%, rgba(0,0,0,.045), transparent 55%);
            pointer-events: none;
        }

    .topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        letter-spacing: .3px;
        text-transform: uppercase;
        font-size: 12px;
        color: var(--muted);
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: var(--text);
        box-shadow: 0 0 0 6px rgba(0,0,0,.06);
    }

    .badge-min {
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 8px 12px;
        color: var(--muted);
        background: rgba(0,0,0,.02);
        font-size: 12px;
        white-space: nowrap;
    }

    /* HERO */
    .hero {
        display: grid;
        grid-template-columns: 1.08fr .92fr;
        gap: 22px;
        align-items: stretch;
        margin-top: 6px;
    }

    @@media (max-width: 960px) {
        .hero {
            grid-template-columns: 1fr;
        }
    }

    .title {
        font-size: clamp(34px, 4.2vw, 58px);
        line-height: 1.03;
        margin: 0 0 10px 0;
        letter-spacing: -.7px;
        color: var(--text);
    }

    .subtitle {
        margin: 0 0 16px 0;
        color: var(--muted);
        font-size: 16px;
        line-height: 1.65;
        max-width: 56ch;
    }

    .kpis {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 14px;
    }

    .pill {
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 10px 12px;
        background: rgba(0,0,0,.02);
        color: var(--text);
        font-size: 13px;
        display: flex;
        gap: 8px;
        align-items: center;
    }

        .pill span {
            color: var(--muted);
        }

    /* SEARCH + CTA */
    .hero-actions {
        margin-top: 18px;
        display: grid;
        gap: 10px;
    }

    .searchbar {
        border: 1px solid var(--line);
        border-radius: 16px;
        background: #fff;
        box-shadow: var(--shadow2);
        padding: 10px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 10px;
        align-items: center;
    }

        .searchbar input {
            border: 1px solid rgba(0,0,0,.12);
            border-radius: 12px;
            padding: 12px 12px;
            outline: none;
            width: 100%;
        }

            .searchbar input:focus {
                border-color: #000;
                box-shadow: 0 0 0 .15rem rgba(0,0,0,.10);
            }

    .btn-bw {
        border: 1px solid #000;
        background: #000;
        color: #fff;
        border-radius: 12px;
        padding: 12px 14px;
        font-weight: 700;
        white-space: nowrap;
        transition: transform .08s ease, background-color .15s ease;
    }

        .btn-bw:hover {
            background: #1b1b1b;
            color: #fff;
        }

        .btn-bw:active {
            transform: scale(.99);
        }

    .cta-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-ghost {
        border: 1px solid rgba(0,0,0,.18);
        background: rgba(255,255,255,.85);
        color: #111;
        border-radius: 12px;
        padding: 10px 12px;
        font-weight: 700;
        transition: background-color .15s ease, transform .08s ease;
        text-decoration: none;
    }

        .btn-ghost:hover {
            background: rgba(0,0,0,.04);
            color: #111;
        }

        .btn-ghost:active {
            transform: scale(.99);
        }

    /* RIGHT HERO VISUAL */
    .hero-visual {
        border: 1px solid var(--line);
        border-radius: 18px;
        background: #fff;
        box-shadow: var(--shadow2);
        overflow: hidden;
        position: relative;
        min-height: 340px;
    }

        .hero-visual .img {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(255,255,255,.00), rgba(255,255,255,.55)), url('/img/hero-car.jpg');
            background-size: cover;
            background-position: center;
            filter: saturate(.92) contrast(1.05);
            transform: scale(1.02);
        }

        .hero-visual .glass {
            position: absolute;
            left: 14px;
            right: 14px;
            bottom: 14px;
            border: 1px solid rgba(0,0,0,.10);
            border-radius: 16px;
            background: rgba(255,255,255,.82);
            backdrop-filter: blur(6px);
            padding: 14px 14px;
            box-shadow: 0 16px 40px rgba(0,0,0,.10);
        }

            .hero-visual .glass strong {
                display: block;
                font-size: 14px;
                margin-bottom: 6px;
                color: #111;
            }

            .hero-visual .glass small {
                color: var(--muted);
                line-height: 1.45;
            }

    /* SECTION BELOW (como funciona + destaques) */
    .below {
        margin-top: 22px;
        border-top: 1px solid var(--line);
        padding-top: 20px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    @@media (max-width: 960px) {
        .below {
            grid-template-columns: 1fr;
        }
    }

    .panel {
        border: 1px solid var(--line);
        border-radius: 18px;
        background: rgba(255,255,255,.85);
        box-shadow: var(--shadow2);
        padding: 16px;
    }

        .panel h3 {
            font-size: 12px;
            margin: 0 0 12px 0;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .25em;
        }

    .steps {
        display: grid;
        gap: 10px;
    }

    .step {
        border: 1px solid rgba(0,0,0,.10);
        border-radius: 16px;
        padding: 12px 12px;
        background: rgba(0,0,0,.02);
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

        .step .n {
            width: 30px;
            height: 30px;
            border-radius: 999px;
            background: #000;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            flex: 0 0 auto;
            margin-top: 2px;
        }

        .step strong {
            display: block;
            font-size: 14px;
            margin-bottom: 4px;
        }

        .step small {
            color: var(--muted);
        }

    /* Destaques (o teu conteúdo, só em cards mais bonitos) */
    .list {
        display: grid;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .item {
        border: 1px solid rgba(0,0,0,.10);
        border-radius: 16px;
        padding: 14px 14px;
        background: rgba(255,255,255,.85);
        box-shadow: 0 10px 28px rgba(0,0,0,.06);
    }

        .item strong {
            display: block;
            font-size: 14px;
            margin-bottom: 6px;
            color: var(--text);
        }

        .item small {
            color: var(--muted);
            line-height: 1.5;
        }

    /* links sem azul */
    a, a:visited {
        color: var(--text);
        text-decoration: none;
        border-bottom: 1px solid rgba(0,0,0,.28);
    }

        a:hover {
            border-bottom-color: rgba(0,0,0,.60);
        }

    .footerline {
        margin-top: 22px;
        padding-top: 16px;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        color: var(--muted);
        font-size: 13px;
    }

    .home-card * {
        position: relative;
    }
</style>

<section class="home-wrap">
    <div class="home-card">
        <div class="topline">
            <div class="brand">
                <span class="dot"></span>
                <span>AutoMarket</span>
            </div>
            <div class="badge-min">Black &amp; White • Minimal</div>
        </div>

        <div class="hero">
            <!-- LEFT -->
            <div>
                <!-- ✅ mantém o teu texto -->
                <h1 class="title">Um marketplace de carros para explorar.</h1>

                <p class="subtitle">
                    Um serviço clean, focado em ajudá-lo a decidir que veículo comprar ou ajudar a vender.
                    Depois você pode ligar essa home às páginas de <a href="/Anuncios/Carros">Carros</a> e <a href="/Home/Privacy">Privacidade</a>.
                </p>

                <div class="kpis">
                    <div class="pill">⚑ <span>Equipa</span> Preocupada</div>
                    <div class="pill">◻︎ <span>Interface</span> Fácil</div>
                    <div class="pill">⟡ <span>Comprar</span> O sonho</div>
                    <div class="pill">↗ <span>Vender</span> O velho</div>
                </div>

                <!-- ✅ acrescenta “cara de marketplace” -->
                <div class="hero-actions">
                    <form class="searchbar" action="/Anuncios/Carros" method="get">
                        <input type="text" name="q" placeholder="Pesquisar por marca, modelo, ano, preço..." />
                        <button type="submit" class="btn-bw">Pesquisar</button>
                    </form>

                    <div class="cta-row">
                        <a class="btn-ghost" href="/Anuncios/Carros">Explorar anúncios</a>
                    </div>
                </div>
            </div>

            <!-- RIGHT (imagem grande) -->
            <aside class="hero-visual" aria-label="Carro em destaque">
                <div class="img"></div>

                <div class="glass">
                    <strong>Encontra o carro certo</strong>
                    <small>Filtra por preço, quilometragem, marca e muito mais — e guarda favoritos para comparar depois.</small>
                </div>
            </aside>
        </div>

        <!-- ✅ secção abaixo: “Como funciona” + “Destaques” -->
        <div class="below">
            <div class="panel">
                <h3>Como funciona</h3>

                <div class="steps">
                    <div class="step">
                        <div class="n">1</div>
                        <div>
                            <strong>Explora e compara</strong>
                            <small>Vê anúncios, detalhes e escolhe o melhor negócio para ti.</small>
                        </div>
                    </div>

                    <div class="step">
                        <div class="n">2</div>
                        <div>
                            <strong>Reserva e acompanha</strong>
                            <small>Faz a tua operação com clareza e mantém tudo organizado na tua conta.</small>
                        </div>
                    </div>

                    <div class="step">
                        <div class="n">3</div>
                        <div>
                            <strong>Vende com confiança</strong>
                            <small>Publica anúncios com fotos, preço e detalhes — e gere visitas facilmente.</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="panel">
                <h3>Destaques</h3>
                <!-- ✅ mantém o teu conteúdo -->
                <ul class="list">
                    <li class="item">
                        <strong>Explorar carros</strong>
                        <small>Liste, filtre e navegue pelos anúncios.</small>
                    </li>
                    <li class="item">
                        <strong>Começar a vender</strong>
                        <small>Área para publicar anúncios com fotos, preço e detalhes.</small>
                    </li>
                    <li class="item">
                        <strong>Conta &amp; segurança</strong>
                        <small>Login/registro e regras claras de privacidade.</small>
                    </li>
                </ul>
            </div>
        </div>

        <div class="footerline">
            <span>© @DateTime.Now.Year • AutoMarket</span>
            <span>Estamos consigo na jornada de adquirir um veículo 🙂</span>
        </div>
    </div>
</section>
