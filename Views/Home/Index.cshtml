@{
    ViewData["Title"] = "AutoMarket";
}

<style>
    :root {
        --bg: #f5f5f5;
        --panel: #ffffff;
        --text: #111111;
        --muted: #5e5e5e;
        --line: rgba(0,0,0,.10);
        --soft: rgba(0,0,0,.05);
    }

    /* Home ocupa a tela, mas clean e branco */
    .home-wrap {
        min-height: calc(100vh - 120px); /* ajusta se header/footer forem maiores */
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 16px;
        background: radial-gradient(1100px 520px at 18% 10%, rgba(0,0,0,.04), transparent 60%), radial-gradient(900px 480px at 82% 38%, rgba(0,0,0,.035), transparent 60%), linear-gradient(180deg, #fafafa, var(--bg));
        color: var(--text);
    }

    .home-card {
        width: min(980px, 100%);
        border: 1px solid var(--line);
        background: linear-gradient(180deg, rgba(255,255,255,1), rgba(255,255,255,.98));
        border-radius: 22px;
        padding: 38px;
        box-shadow: 0 18px 70px rgba(0,0,0,.10);
        position: relative;
        overflow: hidden;
    }

        .home-card:before {
            content: "";
            position: absolute;
            inset: -2px;
            background: radial-gradient(600px 260px at 18% 0%, rgba(0,0,0,.06), transparent 55%), radial-gradient(520px 240px at 85% 20%, rgba(0,0,0,.04), transparent 55%);
            pointer-events: none;
        }

    .topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 26px;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        letter-spacing: .3px;
        text-transform: uppercase;
        font-size: 12px;
        color: var(--muted);
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: var(--text);
        box-shadow: 0 0 0 6px rgba(0,0,0,.06);
    }

    .badge-min {
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 8px 12px;
        color: var(--muted);
        background: rgba(0,0,0,.02);
        font-size: 12px;
        white-space: nowrap;
    }

    .hero {
        display: grid;
        grid-template-columns: 1.15fr .85fr;
        gap: 26px;
        align-items: stretch;
    }

    @@media (max-width: 860px) {
        .hero {
            grid-template-columns: 1fr;
        }
    }

    .title {
        font-size: clamp(34px, 4.2vw, 56px);
        line-height: 1.03;
        margin: 0 0 12px 0;
        letter-spacing: -.6px;
        color: var(--text);
    }

    .subtitle {
        margin: 0 0 18px 0;
        color: var(--muted);
        font-size: 16px;
        line-height: 1.6;
        max-width: 52ch;
    }

    .kpis {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 18px;
    }

    .pill {
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 10px 12px;
        background: rgba(0,0,0,.02);
        color: var(--text);
        font-size: 13px;
        display: flex;
        gap: 8px;
        align-items: center;
    }

        .pill span {
            color: var(--muted);
        }

    .side {
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 18px;
        background: rgba(0,0,0,.02);
    }

        .side h3 {
            font-size: 14px;
            margin: 0 0 12px 0;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .25em;
        }

    .list {
        display: grid;
        gap: 12px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .item {
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 14px 14px;
        background: rgba(255,255,255,.75);
        box-shadow: 0 10px 28px rgba(0,0,0,.06);
    }

        .item strong {
            display: block;
            font-size: 14px;
            margin-bottom: 6px;
            color: var(--text);
        }

        .item small {
            color: var(--muted);
            line-height: 1.5;
        }

    /* links black & white (sem azul) */
    a, a:visited {
        color: var(--text);
        text-decoration: none;
        border-bottom: 1px solid rgba(0,0,0,.28);
    }

        a:hover {
            border-bottom-color: rgba(0,0,0,.60);
        }

    .footerline {
        margin-top: 26px;
        padding-top: 18px;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        color: var(--muted);
        font-size: 13px;
    }

    /* micro refinamentos para ficar “premium” */
    .home-card * {
        position: relative;
    }
    /* mantém o brilho do :before atrás */
</style>

<section class="home-wrap">
    <div class="home-card">
        <div class="topline">
            <div class="brand">
                <span class="dot"></span>
                <span>AutoMarket</span>
            </div>
            <div class="badge-min">Black &amp; White • Minimal</div>
        </div>

        <div class="hero">
            <div>
                <h1 class="title">Um marketplace de carros para explorar.</h1>
                <p class="subtitle">
                    Um serviço clean, focado em ajudá-lo a decidir que veículo comprar ou ajudar a vender.
                    Depois você pode ligar essa home às páginas de <a href="/Carros">Carros</a> e <a href="/Home/Privacy">Privacidade</a>.
                </p>

                <div class="kpis">
                    <div class="pill">⚑ <span>Equipa</span> Preocupada</div>
                    <div class="pill">◻︎ <span>Interface</span> Fácil</div>
                    <div class="pill">⟡ <span>Comprar</span> O sonho</div>
                    <div class="pill">↗ <span>Vender</span> O velho</div>
                </div>
            </div>

            <aside class="side">
                <h3>Destaques</h3>
                <ul class="list">
                    <li class="item">
                        <strong>Explorar carros</strong>
                        <small>Liste, filtre e navegue pelos anúncios.</small>
                    </li>
                    <li class="item">
                        <strong>Começar a vender</strong>
                        <small>Área para publicar anúncios com fotos, preço e detalhes.</small>
                    </li>
                    <li class="item">
                        <strong>Conta &amp; segurança</strong>
                        <small>Login/registro e regras claras de privacidade.</small>
                    </li>
                </ul>
            </aside>
        </div>

        <div class="footerline">
            <span>© @DateTime.Now.Year • AutoMarket</span>
            <span>Estamos consigo na jornada de adquirir um veículo 🙂</span>
        </div>
    </div>
</section>
