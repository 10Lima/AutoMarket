@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="register-page">
    <div class="register-card">

        <h1 class="page-title mb-1">@ViewData["Title"]</h1>
        <p class="page-subtitle mb-0">Enter your email.</p>

        <hr class="manage-hr" />

        <div class="row">
            <div class="col-md-6 col-lg-5">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email"
                               class="form-control"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label"></label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="w-100 btn btn-lg btn-dark-custom">
                        Reset Password
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    /* ===== FULL WIDTH / BREAK OUT DO .container DO LAYOUT ===== */
    .register-page {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        background-color: #f5f5f5;
        min-height: calc(100vh - 70px);
        padding: 32px 20px;
    }

    /* ===== CARD ===== */
    .register-card {
        background-color: #ffffff;
        border-radius: 14px;
        padding: 40px;
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    /* ===== TITULOS ===== */
    .page-title {
        font-weight: 750;
        color: #111;
        letter-spacing: -0.4px;
        margin: 0;
    }

    .page-subtitle {
        color: #555;
        line-height: 1.55;
        margin-top: 6px;
    }

    .manage-hr {
        margin: 18px 0 22px 0;
        border-top: 1px solid rgba(0,0,0,0.10);
        opacity: 1;
    }

    /* ===== INPUTS ===== */
    .form-control, .form-select {
        border-radius: 10px;
        border: 1px solid #d0d0d0;
    }

        .form-control:focus, .form-select:focus {
            border-color: #000;
            box-shadow: 0 0 0 0.15rem rgba(0, 0, 0, 0.12);
        }

    /* ===== BOTÃO PRETO ===== */
    .btn-dark-custom {
        background-color: #000;
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 12px 14px;
        font-weight: 650;
        transition: transform 0.08s ease-in-out, background-color 0.15s ease-in-out;
    }

        .btn-dark-custom:hover {
            background-color: #1b1b1b;
            color: #fff;
        }

        .btn-dark-custom:active {
            transform: scale(0.99);
        }

    /* ===== MOBILE ===== */
    @@media (max-width: 576px) {
        .register-page

    {
        padding: 18px 12px;
    }

    .register-card {
        padding: 22px;
    }

    }
</style>
