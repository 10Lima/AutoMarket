@page
@model AutoMarket.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="register-page">
    <div class="register-card">
        <h1 class="text-center mb-4">@ViewData["Title"]</h1>

        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <section>
                    <form id="account" method="post">
                        <h2 class="h4 mb-3">Entrar</h2>
                        <hr class="mb-4" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Login" class="form-control" autocomplete="username" aria-required="true" />
                            <label asp-for="Input.Login"></label>
                            <span asp-validation-for="Input.Login" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                            <label asp-for="Input.Password"></label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="checkbox mb-3">
                            <label asp-for="Input.RememberMe" class="form-label">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>

                        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-dark-custom">
                            Entrar
                        </button>

                        <div class="mt-3">
                            <p class="mb-1">
                                <a id="forgot-password" asp-page="./ForgotPassword">Esqueceste-te da password?</a>
                            </p>
                            <p class="mb-0">
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Registar nova conta</a>
                            </p>
                        </div>
                    </form>
                </section>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    /* ===== FULL WIDTH / BREAK OUT DO .container DO LAYOUT ===== */
    .register-page {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        background-color: #f5f5f5;
        min-height: calc(100vh - 70px);
        padding: 32px 20px;
    }

    /* ===== CARD ===== */
    .register-card {
        background-color: #ffffff;
        border-radius: 14px;
        padding: 40px;
        width: 100%;
        max-width: 1100px; /* mais compacto, já não há coluna extra */
        margin: 0 auto;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

        /* ===== TÍTULOS ===== */
        .register-card h1,
        .register-card h2,
        .register-card h3,
        .register-card h4 {
            color: #111;
            font-weight: 650;
        }

    /* ===== INPUTS ===== */
    .form-control,
    .form-select {
        border-radius: 10px;
        border: 1px solid #d0d0d0;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #000;
            box-shadow: 0 0 0 0.15rem rgba(0, 0, 0, 0.12);
        }

    /* ===== CHECKBOX ===== */
    .form-check-input:checked {
        background-color: #000;
        border-color: #000;
    }

    .form-check-input:focus {
        box-shadow: 0 0 0 0.15rem rgba(0, 0, 0, 0.12);
    }

    /* ===== BOTÃO PRINCIPAL PRETO ===== */
    .btn-dark-custom {
        background-color: #000;
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 12px 14px;
        font-weight: 600;
        transition: transform 0.08s ease-in-out, background-color 0.15s ease-in-out;
    }

        .btn-dark-custom:hover {
            background-color: #1b1b1b;
            color: #fff;
        }

        .btn-dark-custom:active {
            transform: scale(0.99);
        }

    /* ===== LINKS ===== */
    a {
        color: #111;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

        a:hover {
            color: #000;
        }

    /* ===== MOBILE ===== */
    @@media (max-width: 576px) {
        .register-page

    {
        padding: 18px 12px;
    }

    .register-card {
        padding: 22px;
    }

    }
</style>
