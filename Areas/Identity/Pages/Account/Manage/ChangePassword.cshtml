@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Alterar password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="manage-page-title">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-lg-8 col-xl-7">
        <form id="change-password-form" method="post" class="manage-form">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.OldPassword" class="form-label"></label>
                <input asp-for="Input.OldPassword"
                       class="form-control"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="Please enter your old password." />
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.NewPassword" class="form-label"></label>
                <input asp-for="Input.NewPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Please enter your new password." />
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Please confirm your new password." />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">
                Alterar password
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    /* Só para esta página: garantir que fica com o mesmo visual do "Manage" */

    .manage-page-title {
        font-weight: 750;
        letter-spacing: -0.3px;
        margin-bottom: 14px;
        color: #111;
    }

    /* inputs no teu estilo */
    .manage-form .form-control {
        border-radius: 10px;
        border: 1px solid #d0d0d0;
        padding: 12px 14px;
    }

        .manage-form .form-control:focus {
            border-color: #000;
            box-shadow: 0 0 0 0.15rem rgba(0,0,0,0.12);
        }

    /* botão preto (sem mexer no html do resto, porque está .btn-primary) */
    .manage-form .btn-primary {
        background-color: #000 !important;
        border-color: #000 !important;
        color: #fff !important;
        border-radius: 12px;
        font-weight: 650;
        padding: 12px 14px;
    }

        .manage-form .btn-primary:hover {
            background-color: #1b1b1b !important;
            border-color: #1b1b1b !important;
        }
</style>
